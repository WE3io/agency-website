---
const { title = "Agency" } = Astro.props;
const navItems = [
  { href: "/", label: "Home" },
  { href: "/services", label: "Services" },
  { href: "/work", label: "Work" },
  { href: "/about", label: "About" },
  { href: "/contact", label: "Contact" },
  { href: "/blog", label: "Blog" },
];
---
<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <style>
      :root {
        color-scheme: light;
      }
      body {
        margin: 0;
        font-family: "Charter", "Georgia", serif;
        line-height: 1.6;
        color: #1f1f1f;
        background: #fafafa;
      }
      .wrapper {
        max-width: 720px;
        margin: 0 auto;
        padding: 48px 24px 72px;
      }
      header {
        margin-bottom: 40px;
      }
      nav {
        display: flex;
        flex-wrap: wrap;
        gap: 12px 18px;
      }
      nav a {
        color: inherit;
        text-decoration: none;
        border-bottom: 1px solid #1f1f1f;
      }
      nav a:hover {
        border-bottom-color: transparent;
      }
      h1, h2, h3 {
        line-height: 1.25;
      }
      article {
        display: grid;
        gap: 24px;
      }
      footer {
        margin-top: 48px;
        font-size: 0.9rem;
        color: #4a4a4a;
      }
      ul {
        padding-left: 18px;
      }
    </style>
  </head>
  <body>
    <div class="wrapper">
      <header>
        <nav>
          {navItems.map((item) => (
            <a href={item.href}>{item.label}</a>
          ))}
        </nav>
      </header>
      <main>
        <slot />
      </main>
      <footer>
        <p>We build calm, clear digital work.</p>
      </footer>
    </div>
  </body>
</html>
