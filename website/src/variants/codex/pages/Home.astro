---
import { getCollection } from "astro:content";
import CodexLayout from "../layouts/CodexLayout.astro";
import Hero from "../components/Hero.astro";
import Section from "../components/Section.astro";
import BriefBuilder from "../components/BriefBuilder.astro";

const entries = await getCollection("pages");
const codexEntries = entries.filter((entry) => entry.id.startsWith("codex/"));
const getEntry = (slug) => codexEntries.find((entry) => entry.id === `codex/${slug}`);

const heroEntry = getEntry("hero");
const whyEntry = getEntry("why-we3");
const serveEntry = getEntry("who-we-serve");
const triadEntry = getEntry("triad-model");
const layersEntry = getEntry("three-layer-team");
const engagementEntry = getEntry("engagement-modes");
const pricingEntry = getEntry("pricing");
const proofEntry = getEntry("case-studies");
const communityEntry = getEntry("community");
const valuesEntry = getEntry("values");
const contactEntry = getEntry("contact");

const renderContent = async (entry) => entry ? await entry.render() : null;

const heroContent = await renderContent(heroEntry);
const whyContent = await renderContent(whyEntry);
const serveContent = await renderContent(serveEntry);
const triadContent = await renderContent(triadEntry);
const layersContent = await renderContent(layersEntry);
const engagementContent = await renderContent(engagementEntry);
const pricingContent = await renderContent(pricingEntry);
const proofContent = await renderContent(proofEntry);
const communityContent = await renderContent(communityEntry);
const valuesContent = await renderContent(valuesEntry);
const contactContent = await renderContent(contactEntry);

const { initialSection = "" } = Astro.props;
---
<CodexLayout title="WE3 Codex">
  <main class="codex-container">
    {heroEntry && heroContent ? (
      <Hero title={heroEntry.data.title} lead={heroEntry.data.description}>
        <heroContent.Content />
      </Hero>
    ) : null}

    {whyEntry && whyContent ? (
      <Section id="why-we3" eyebrow="Origin" title={whyEntry.data.title}>
        <whyContent.Content />
      </Section>
    ) : null}

    {serveEntry && serveContent ? (
      <Section id="who-we-serve" eyebrow="Audience" title={serveEntry.data.title}>
        <serveContent.Content />
      </Section>
    ) : null}

    {triadEntry && triadContent ? (
      <Section id="triad-model" eyebrow="Model" title={triadEntry.data.title}>
        <triadContent.Content />
      </Section>
    ) : null}

    {layersEntry && layersContent ? (
      <Section id="three-layer-team" eyebrow="Structure" title={layersEntry.data.title}>
        <layersContent.Content />
      </Section>
    ) : null}

    {engagementEntry && engagementContent ? (
      <Section id="engagement-modes" eyebrow="Engagement" title={engagementEntry.data.title}>
        <engagementContent.Content />
      </Section>
    ) : null}

    {pricingEntry && pricingContent ? (
      <Section id="pricing-teaser" eyebrow="Pricing" title={pricingEntry.data.title}>
        <pricingContent.Content />
      </Section>
    ) : null}

    {proofEntry && proofContent ? (
      <Section id="case-studies" eyebrow="Proof" title={proofEntry.data.title}>
        <proofContent.Content />
      </Section>
    ) : null}

    {communityEntry && communityContent ? (
      <Section id="community" eyebrow="Community" title={communityEntry.data.title}>
        <communityContent.Content />
      </Section>
    ) : null}

    {valuesEntry && valuesContent ? (
      <Section id="values" eyebrow="Values" title={valuesEntry.data.title}>
        <valuesContent.Content />
      </Section>
    ) : null}

    <BriefBuilder />

    {contactEntry && contactContent ? (
      <Section id="contact" eyebrow="Contact" title={contactEntry.data.title}>
        <contactContent.Content />
      </Section>
    ) : null}

    <footer class="codex-footer">
      <span>Privacy: Your brief stays local. Nothing is stored on our servers.</span>
      <span>WE3 — Small Teams for Big Challenges.</span>
    </footer>
  </main>
</CodexLayout>

{initialSection ? (
  <script>
    const target = document.getElementById(initialSection);
    if (target) target.scrollIntoView({ behavior: "smooth" });
  </script>
) : null}
