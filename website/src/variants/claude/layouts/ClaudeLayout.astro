---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const { title = "WE3", description = "Small teams for big challenges" } = Astro.props;
const currentPath = Astro.url.pathname;

const navItems = [
  { href: "/claude", label: "Home" },
  { href: "/claude/story", label: "Our Story" },
  { href: "/claude/model", label: "The Model" },
  { href: "/claude/engagements", label: "Engagements" },
  { href: "/claude/work", label: "Work" },
  { href: "/claude/brief", label: "Brief Builder" },
  { href: "/claude/contact", label: "Contact" },
];

function isActive(href: string): boolean {
  if (href === "/claude") {
    return currentPath === "/claude" || currentPath === "/claude/";
  }
  return currentPath.startsWith(href);
}
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content={description} />
  <title>{title} | WE3</title>

  <!-- Fonts: Cormorant Garamond (display), Work Sans (body), IBM Plex Mono (accent) -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&family=IBM+Plex+Mono:wght@300;400;500&family=Work+Sans:wght@300;400;500;600&display=swap" rel="stylesheet" />

  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
</head>

<body class="variant-claude">
  <!-- Skip link for accessibility -->
  <a href="#main-content" class="skip-link">Skip to main content</a>

  <!-- Header / Navigation -->
  <header class="site-header">
    <nav class="nav container" aria-label="Main navigation">
      <a href="/claude" class="nav__logo" aria-label="WE3 Home">
        <img src="/images/we3-logo.svg" alt="WE3" class="nav__logo-img" width="48" height="48" />
      </a>

      <button class="nav__toggle" aria-label="Toggle menu" aria-expanded="false">
        <span class="nav__toggle-bar"></span>
        <span class="nav__toggle-bar"></span>
        <span class="nav__toggle-bar"></span>
      </button>

      <ul class="nav__menu" role="list">
        {navItems.map((item) => (
          <li>
            <a
              href={item.href}
              class:list={["nav__link", { "nav__link--active": isActive(item.href) }]}
              aria-current={isActive(item.href) ? "page" : undefined}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <!-- Decorative stripe -->
    <div class="stripe stripe--thin" aria-hidden="true"></div>
  </header>

  <!-- Main Content -->
  <main id="main-content">
    <slot />
  </main>

  <!-- Footer -->
  <footer class="site-footer">
    <div class="stripe stripe--thin" aria-hidden="true"></div>

    <div class="footer__content container">
      <div class="footer__brand">
        <img src="/images/we3-logo.svg" alt="WE3" class="footer__logo-img" width="56" height="56" />
        <p class="footer__tagline">Small teams for big challenges.</p>
      </div>

      <nav class="footer__nav" aria-label="Footer navigation">
        <ul role="list">
          <li><a href="/claude/story">Our Story</a></li>
          <li><a href="/claude/model">The Model</a></li>
          <li><a href="/claude/engagements">Engagements</a></li>
          <li><a href="/claude/work">Work</a></li>
          <li><a href="/claude/brief">Brief Builder</a></li>
          <li><a href="/claude/contact">Contact</a></li>
        </ul>
      </nav>

      <div class="footer__cta">
        <p class="eyebrow">Ready to build?</p>
        <a href="/claude/brief" class="btn btn--primary">Start Your Brief</a>
      </div>
    </div>

    <div class="footer__bottom container">
      <p class="footer__copyright">
        <span class="mono">&copy; {new Date().getFullYear()}</span> WE3 Ventures Ltd.
      </p>
      <a href="/" class="footer__variant-link">Switch variant</a>
    </div>
  </footer>

  <!-- Mobile nav script -->
  <script>
    const toggle = document.querySelector('.nav__toggle');
    const menu = document.querySelector('.nav__menu');

    toggle?.addEventListener('click', () => {
      const expanded = toggle.getAttribute('aria-expanded') === 'true';
      toggle.setAttribute('aria-expanded', (!expanded).toString());
      menu?.classList.toggle('nav__menu--open');
    });
  </script>
</body>
</html>

<style>
  /* Skip link */
  .skip-link {
    position: absolute;
    top: -100%;
    left: 50%;
    transform: translateX(-50%);
    padding: 8px 16px;
    background: var(--c-accent);
    color: var(--c-button-text);
    border-radius: var(--radius-sm);
    z-index: 1000;
    transition: top var(--transition-fast);
  }

  .skip-link:focus {
    top: var(--space-sm);
    outline: 2px solid var(--c-accent);
    outline-offset: 2px;
  }

  /* Header */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--c-bg);
  }

  .nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-lg);
    padding-top: var(--space-md);
    padding-bottom: var(--space-md);
  }

  .nav__logo {
    text-decoration: none;
  }

  .nav__logo-img {
    display: block;
    width: 48px;
    height: 48px;
    object-fit: contain;
  }

  .nav__toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 36px;
    height: 36px;
    padding: 8px;
    background: transparent;
    border: 1px solid var(--c-border);
    border-radius: var(--radius-sm);
    cursor: pointer;
  }

  .nav__toggle-bar {
    display: block;
    width: 100%;
    height: 2px;
    background: var(--c-text);
    border-radius: 1px;
    transition: transform var(--transition-fast);
  }

  .nav__menu {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav__link {
    display: block;
    padding: 8px 14px;
    font-size: var(--text-sm);
    color: var(--c-muted);
    text-decoration: none;
    border-radius: var(--radius-full);
    transition: color var(--transition-fast), background var(--transition-fast);
  }

  .nav__link:hover {
    color: var(--c-text);
    text-decoration: none;
  }

  .nav__link--active {
    color: var(--c-text);
    background: var(--c-surface);
    box-shadow: var(--shadow-sm);
  }

  /* Footer */
  .site-footer {
    margin-top: var(--space-section);
    background: var(--c-surface-2);
  }

  .footer__content {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: var(--space-xl);
    padding: var(--space-xl) var(--space-lg);
    align-items: start;
  }

  .footer__brand {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .footer__logo-img {
    display: block;
    width: 56px;
    height: 56px;
    object-fit: contain;
  }

  .footer__tagline {
    font-size: var(--text-sm);
    color: var(--c-muted);
    font-style: italic;
  }

  .footer__nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm) var(--space-lg);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .footer__nav a {
    font-size: var(--text-sm);
    color: var(--c-muted);
  }

  .footer__nav a:hover {
    color: var(--c-accent);
  }

  .footer__cta {
    text-align: right;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: var(--space-sm);
  }

  .footer__bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: var(--space-md) var(--space-lg);
    border-top: 1px solid var(--c-border);
  }

  .footer__copyright {
    font-size: var(--text-sm);
    color: var(--c-muted);
  }

  .footer__variant-link {
    font-family: var(--font-accent);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--c-muted);
  }

  /* Mobile responsive */
  @media (max-width: 900px) {
    .nav__toggle {
      display: flex;
    }

    .nav__menu {
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      flex-direction: column;
      align-items: stretch;
      padding: var(--space-md);
      background: var(--c-surface);
      border-bottom: 1px solid var(--c-border);
      box-shadow: var(--shadow-md);
      display: none;
    }

    .nav__menu--open {
      display: flex;
    }

    .nav__link {
      padding: 12px 16px;
    }

    .footer__content {
      grid-template-columns: 1fr;
      gap: var(--space-lg);
    }

    .footer__cta {
      text-align: left;
      align-items: flex-start;
    }
  }
</style>
