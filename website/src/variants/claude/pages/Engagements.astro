---
import ClaudeLayout from "../layouts/ClaudeLayout.astro";
---

<ClaudeLayout title="Engagements" description="Four ways to work with WE3 - strategic consulting, co-building startups, venture creation, and community.">
  <!-- Page Header -->
  <section class="page-header">
    <div class="container container--narrow">
      <p class="eyebrow">Engagement Modes</p>
      <h1>Four Ways to Work With Us</h1>
      <p class="page-header__lead">
        WE3 is designed as a bespoke consultancy that flexes to different kinds of opportunities.
        From strategic consulting to venture creation, we structure engagements to match your needs.
      </p>
    </div>
  </section>

  <!-- Strategic Consulting -->
  <section id="consulting" class="section engagement-section">
    <div class="container">
      <div class="engagement-layout">
        <div class="engagement-number">
          <span class="mono">01</span>
        </div>

        <div class="engagement-content">
          <div class="section-header">
            <span class="section-header__label">For Industry Leaders</span>
            <div class="section-header__rule"></div>
          </div>

          <h2>Strategic Consulting</h2>

          <p class="engagement-lead">
            High-stakes, complex problems. We partner with corporate clients and private equity firms
            to drive from insight to implementation.
          </p>

          <div class="engagement-details">
            <div class="engagement-detail">
              <h4>How it works</h4>
              <p>
                A WE3 trio (product, design, engineering) embeds with your team to rapidly understand
                the challenge and drive from insight to implementation. Unlike a traditional consulting
                team that might deliver a PowerPoint and leave, our trio stays hands-on through execution.
              </p>
            </div>

            <div class="engagement-detail">
              <h4>What you get</h4>
              <ul>
                <li>Senior experts who can both think and build</li>
                <li>Actionable strategy and tangible outcomes</li>
                <li>The velocity of a skunkworks team with outside perspective</li>
                <li>Real prototypes, not just recommendations</li>
              </ul>
            </div>

            <div class="engagement-detail">
              <h4>Best for</h4>
              <ul>
                <li>Digital transformation initiatives</li>
                <li>Product strategy and roadmapping</li>
                <li>Customer experience redesign</li>
                <li>Technology assessment and architecture</li>
              </ul>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <div class="stripe stripe--thin container" aria-hidden="true"></div>

  <!-- Co-Building Startups -->
  <section id="co-building" class="section engagement-section">
    <div class="container">
      <div class="engagement-layout">
        <div class="engagement-number">
          <span class="mono">02</span>
        </div>

        <div class="engagement-content">
          <div class="section-header">
            <span class="section-header__label">For Founders</span>
            <div class="section-header__rule"></div>
          </div>

          <h2>Co-Building Startups</h2>

          <p class="engagement-lead">
            We become temporary co-founders. Time, expertise, and sometimes capital—with
            skin in the game through equity or profit-share.
          </p>

          <div class="engagement-details">
            <div class="engagement-detail">
              <h4>How it works</h4>
              <p>
                We invest our time and expertise to build early-stage ideas alongside the founding
                team. Our interdisciplinary trio works to rapidly validate the concept, build the MVP,
                and find product-market fit. We don't just advise—we build together.
              </p>
            </div>

            <div class="engagement-detail">
              <h4>What you get</h4>
              <ul>
                <li>A ready-made senior product/design/engineering team from day zero</li>
                <li>Massively accelerated development</li>
                <li>Aligned incentives through equity or profit-share</li>
                <li>Network access to specialists and potential investors</li>
              </ul>
            </div>

            <div class="engagement-detail">
              <h4>Best for</h4>
              <ul>
                <li>Pre-seed and seed-stage startups</li>
                <li>Corporate spin-outs needing rapid execution</li>
                <li>Solo founders who need a technical co-founder team</li>
                <li>Ideas that need fast validation and iteration</li>
              </ul>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <div class="stripe stripe--thin container" aria-hidden="true"></div>

  <!-- Venture Creation -->
  <section id="ventures" class="section engagement-section">
    <div class="container">
      <div class="engagement-layout">
        <div class="engagement-number">
          <span class="mono">03</span>
        </div>

        <div class="engagement-content">
          <div class="section-header">
            <span class="section-header__label">Internal Studio</span>
            <div class="section-header__rule"></div>
          </div>

          <h2>Venture Creation</h2>

          <p class="engagement-lead">
            Ideas we originate or source from our community. Validated, incubated, and
            spun out as independent companies.
          </p>

          <div class="engagement-details">
            <div class="engagement-detail">
              <h4>How it works</h4>
              <p>
                When we spot a real market gap—either from our own brainstorms or from our community—we
                rally our trio and resources to explore it. Promising concepts go through validation and,
                if they gain traction, we formally incubate them under WE3's roof before spinning them out.
              </p>
            </div>

            <div class="engagement-detail">
              <h4>What we provide</h4>
              <ul>
                <li>Seed funding and operational support</li>
                <li>Full stack of product/design/engineering talent</li>
                <li>Mentorship and strategic guidance</li>
                <li>Network of entrepreneurs and potential partners</li>
              </ul>
            </div>

            <div class="engagement-detail">
              <h4>What we're looking for</h4>
              <ul>
                <li>Ideas with clear market validation potential</li>
                <li>Problems we're passionate about solving</li>
                <li>Community members with founder potential</li>
                <li>Opportunities that align with our values</li>
              </ul>
            </div>
          </div>

          <div class="engagement-cta">
            <p>Have an idea you think we should explore?</p>
            <a href="/claude/contact" class="btn btn--secondary">Pitch to us</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <div class="stripe stripe--thin container" aria-hidden="true"></div>

  <!-- Community -->
  <section id="community" class="section engagement-section">
    <div class="container">
      <div class="engagement-layout">
        <div class="engagement-number">
          <span class="mono">04</span>
        </div>

        <div class="engagement-content">
          <div class="section-header">
            <span class="section-header__label">For Everyone</span>
            <div class="section-header__rule"></div>
          </div>

          <h2>Community Engagement</h2>

          <p class="engagement-lead">
            Open-source tools, resources, and events. We're building a community of builders
            who share our values and want to learn together.
          </p>

          <div class="engagement-details">
            <div class="engagement-detail">
              <h4>What we offer</h4>
              <p>
                We host meetups, contribute to open-source projects, mentor at hackathons—all ways
                to stay connected with fresh ideas and talent. This community isn't just for show;
                it's an extension of WE3.
              </p>
            </div>

            <div class="engagement-detail">
              <h4>Resources</h4>
              <ul>
                <li>Brief Builder (free tool for project scoping)</li>
                <li>Open-source templates and frameworks</li>
                <li>Educational content and guides</li>
                <li>Community events and workshops</li>
              </ul>
            </div>

            <div class="engagement-detail">
              <h4>Get involved</h4>
              <ul>
                <li>Use our tools and share feedback</li>
                <li>Attend or speak at our events</li>
                <li>Contribute to open-source projects</li>
                <li>Apply to our apprenticeship program</li>
              </ul>
            </div>
          </div>

          <div class="engagement-cta">
            <p>Explore our open-source tools and resources.</p>
            <a href="/claude/tools" class="btn btn--primary">Browse the Collection</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- How to Choose -->
  <section class="section section--alt">
    <div class="container container--narrow">
      <div class="section-header">
        <span class="section-header__label">Finding the Right Fit</span>
        <div class="section-header__rule"></div>
      </div>

      <div class="fit-guide">
        <h2>Not sure which is right for you?</h2>
        <p>
          Our Brief Builder will help you articulate your challenge and suggest the best
          engagement mode based on your needs, timeline, and budget. It's free, fast, and
          your data stays local.
        </p>

        <div class="fit-cards">
          <div class="fit-card">
            <h4>You have a specific problem to solve</h4>
            <p>Strategic Consulting is likely your best fit.</p>
            <span class="badge">Consulting</span>
          </div>

          <div class="fit-card">
            <h4>You're building something new from scratch</h4>
            <p>Co-Building might be the right model.</p>
            <span class="badge">Co-Building</span>
          </div>

          <div class="fit-card">
            <h4>You have an idea but no team</h4>
            <p>Let's talk about Venture Creation.</p>
            <span class="badge">Ventures</span>
          </div>

          <div class="fit-card">
            <h4>You want to learn or contribute</h4>
            <p>Join our Community—start with the Brief Builder.</p>
            <span class="badge">Community</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section cta-section">
    <div class="container">
      <div class="cta-panel panel text-center">
        <p class="eyebrow">Ready to start?</p>
        <h2>Let's figure out the right engagement together.</h2>
        <p class="cta-panel__text">
          Use our Brief Builder to articulate your challenge, or reach out directly
          to start a conversation.
        </p>
        <div class="cta-panel__actions">
          <a href="/claude/brief" class="btn btn--primary">Start Your Brief</a>
          <a href="/claude/contact" class="btn btn--secondary">Contact Us</a>
        </div>
      </div>
    </div>
  </section>
</ClaudeLayout>

<style>
  /* Page Header */
  .page-header {
    padding: var(--space-2xl) 0 var(--space-xl);
  }

  .page-header h1 {
    margin: var(--space-sm) 0 var(--space-md);
  }

  .page-header__lead {
    font-size: var(--text-xl);
    color: var(--c-muted);
    line-height: 1.5;
  }

  /* Sections */
  .section {
    padding: var(--space-section) 0;
  }

  .section--alt {
    background: var(--c-surface-2);
  }

  /* Engagement Section */
  .engagement-section {
    scroll-margin-top: 100px;
  }

  .engagement-layout {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-xl);
  }

  .engagement-number {
    font-size: var(--text-hero);
    color: var(--c-accent);
    opacity: 0.3;
    font-weight: 300;
    line-height: 1;
  }

  .engagement-content h2 {
    font-size: var(--text-3xl);
    margin-bottom: var(--space-md);
  }

  .engagement-lead {
    font-size: var(--text-xl);
    color: var(--c-muted);
    max-width: 55ch;
    margin-bottom: var(--space-xl);
  }

  .engagement-details {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: var(--space-lg);
  }

  .engagement-detail {
    padding: var(--space-lg);
    background: var(--c-surface);
    border: 1px solid var(--c-border);
    border-radius: var(--radius-md);
  }

  .engagement-detail h4 {
    font-family: var(--font-accent);
    font-size: var(--text-sm);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--c-accent);
    margin-bottom: var(--space-sm);
    font-weight: 500;
  }

  .engagement-detail p {
    color: var(--c-muted);
    font-size: var(--text-sm);
    line-height: 1.6;
    margin: 0;
  }

  .engagement-detail ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .engagement-detail li {
    font-size: var(--text-sm);
    color: var(--c-muted);
    padding-left: var(--space-md);
    position: relative;
  }

  .engagement-detail li::before {
    content: "•";
    position: absolute;
    left: 0;
    color: var(--c-accent);
  }

  .engagement-cta {
    margin-top: var(--space-xl);
    padding: var(--space-lg);
    background: var(--c-surface-2);
    border-radius: var(--radius-md);
    display: flex;
    align-items: center;
    gap: var(--space-lg);
  }

  .engagement-cta p {
    margin: 0;
    color: var(--c-muted);
  }

  /* Fit Guide */
  .fit-guide h2 {
    margin-bottom: var(--space-md);
  }

  .fit-guide > p {
    font-size: var(--text-lg);
    color: var(--c-muted);
    margin-bottom: var(--space-xl);
  }

  .fit-cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: var(--space-md);
  }

  .fit-card {
    padding: var(--space-lg);
    background: var(--c-surface);
    border: 1px solid var(--c-border);
    border-radius: var(--radius-md);
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .fit-card h4 {
    font-size: var(--text-lg);
    font-family: var(--font-display);
    margin: 0;
  }

  .fit-card p {
    font-size: var(--text-sm);
    color: var(--c-muted);
    margin: 0;
    flex: 1;
  }

  /* CTA Section */
  .cta-section {
    padding-bottom: 0;
  }

  .cta-panel.text-center h2 {
    margin: var(--space-xs) 0 var(--space-md);
  }

  .cta-panel__text {
    color: var(--c-muted);
    max-width: 50ch;
    margin: 0 auto var(--space-lg);
  }

  .cta-panel__actions {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: var(--space-sm);
  }

  /* Responsive */
  @media (max-width: 768px) {
    .engagement-layout {
      grid-template-columns: 1fr;
      gap: var(--space-md);
    }

    .engagement-number {
      font-size: var(--text-3xl);
    }

    .engagement-cta {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
