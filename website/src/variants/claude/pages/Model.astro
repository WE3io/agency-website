---
import ClaudeLayout from "../layouts/ClaudeLayout.astro";
---

<ClaudeLayout title="The Model" description="WE3's three-layer team structure - senior triads, fractional specialists, and apprentices working together.">
  <!-- Page Header -->
  <section class="page-header">
    <div class="container container--narrow">
      <p class="eyebrow">The WE3 Model</p>
      <h1>Three Layers. Zero Waste.</h1>
      <p class="page-header__lead">
        At the heart of WE3 is a simple idea: small, senior interdisciplinary teams can drive
        outsized impact on complex problems. Here's how we structure every engagement.
      </p>
    </div>
  </section>

  <!-- Model Visualization -->
  <section class="section">
    <div class="container">
      <div class="model-visual">
        <!-- Core Triad -->
        <div class="model-layer model-layer--core">
          <div class="model-layer__header">
            <span class="badge badge--accent">Core</span>
            <h2>Senior Triad</h2>
          </div>
          <p class="model-layer__desc">
            The nucleus of every WE3 project. Three senior leaders who own strategy,
            make decisions, and deliver outcomes together.
          </p>
          <div class="triad-visual">
            <div class="triad-node triad-node--product">
              <span class="triad-node__icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                  <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/>
                  <line x1="3" y1="9" x2="21" y2="9"/>
                  <line x1="9" y1="21" x2="9" y2="9"/>
                </svg>
              </span>
              <span class="triad-node__label">Product</span>
              <span class="triad-node__role">Strategist</span>
            </div>
            <div class="triad-node triad-node--design">
              <span class="triad-node__icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                  <circle cx="12" cy="12" r="10"/>
                  <line x1="12" y1="8" x2="12" y2="16"/>
                  <line x1="8" y1="12" x2="16" y2="12"/>
                </svg>
              </span>
              <span class="triad-node__label">Design</span>
              <span class="triad-node__role">Lead</span>
            </div>
            <div class="triad-node triad-node--engineering">
              <span class="triad-node__icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                  <polyline points="16 18 22 12 16 6"/>
                  <polyline points="8 6 2 12 8 18"/>
                </svg>
              </span>
              <span class="triad-node__label">Engineering</span>
              <span class="triad-node__role">Lead</span>
            </div>
            <svg class="triad-lines" viewBox="0 0 300 200" aria-hidden="true">
              <line x1="75" y1="100" x2="150" y2="100" stroke="currentColor" stroke-width="1" opacity="0.3"/>
              <line x1="150" y1="100" x2="225" y2="100" stroke="currentColor" stroke-width="1" opacity="0.3"/>
              <line x1="75" y1="100" x2="225" y2="100" stroke="currentColor" stroke-width="1" opacity="0.15" stroke-dasharray="4"/>
            </svg>
          </div>
        </div>

        <!-- Fractional Specialists -->
        <div class="model-layer model-layer--fractional">
          <div class="model-layer__header">
            <span class="badge">Flexible</span>
            <h2>Fractional Specialists</h2>
          </div>
          <p class="model-layer__desc">
            Surge capacity and deep expertise on-demand. Our network of trusted specialists
            extends the core team without bloat.
          </p>
          <div class="specialists-grid">
            <div class="specialist-tag">UX Research</div>
            <div class="specialist-tag">Cloud Architecture</div>
            <div class="specialist-tag">Data Science</div>
            <div class="specialist-tag">Growth Marketing</div>
            <div class="specialist-tag">Security</div>
            <div class="specialist-tag">DevOps</div>
            <div class="specialist-tag specialist-tag--more">+ more</div>
          </div>
        </div>

        <!-- Apprentice Triad -->
        <div class="model-layer model-layer--apprentice">
          <div class="model-layer__header">
            <span class="badge">Future</span>
            <h2>Apprentice Triad</h2>
          </div>
          <p class="model-layer__desc">
            One apprentice per discipline shadows the seniors. Real work, real mentorship.
            We're building the next generation while delivering today.
          </p>
          <div class="apprentice-visual">
            <div class="apprentice-node">
              <span class="mono">PM</span>
              <span>Apprentice</span>
            </div>
            <div class="apprentice-node">
              <span class="mono">Design</span>
              <span>Apprentice</span>
            </div>
            <div class="apprentice-node">
              <span class="mono">Eng</span>
              <span>Apprentice</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Why This Model -->
  <section class="section section--alt">
    <div class="container container--narrow">
      <div class="section-header">
        <span class="section-header__label">Why It Works</span>
        <div class="section-header__rule"></div>
      </div>

      <div class="benefits-list">
        <article class="benefit">
          <div class="benefit__number mono">01</div>
          <div class="benefit__content">
            <h3>No Handoff Gaps</h3>
            <p>
              All three leaders are equal partners on the mission, aligning user needs,
              business goals, and technical realities in tandem. By having design, product,
              and engineering at the table from the start, we avoid the misalignment that
              often plagues big projects.
            </p>
          </div>
        </article>

        <article class="benefit">
          <div class="benefit__number mono">02</div>
          <div class="benefit__content">
            <h3>Senior-Heavy, Lean Delivery</h3>
            <p>
              Clients aren't paying for a crowd of junior staff to learn on the job.
              Instead they get a focused unit of experts tackling the problem directly.
              Faster turnaround and higher-quality outputs, with no wasted motion.
            </p>
          </div>
        </article>

        <article class="benefit">
          <div class="benefit__number mono">03</div>
          <div class="benefit__content">
            <h3>Flexible Scale</h3>
            <p>
              The fractional team members ensure we never hit a skills gap, while keeping
              the core team lean. They can scale up briefly without carrying a bloated team
              throughout the project.
            </p>
          </div>
        </article>

        <article class="benefit">
          <div class="benefit__number mono">04</div>
          <div class="benefit__content">
            <h3>Built-in Mentorship</h3>
            <p>
              Our apprentice triad is a win-win-win: new talent gets a launchpad, our seniors
              amplify their impact through mentorship, and clients benefit from a broader team
              that's motivated and cost-effective.
            </p>
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- Cost Bands -->
  <section class="section">
    <div class="container">
      <div class="section-header">
        <span class="section-header__label">Engagement Scale</span>
        <div class="section-header__rule"></div>
      </div>

      <div class="cost-intro">
        <h2>Right-Sized for Your Challenge</h2>
        <p>
          We structure engagements to match the complexity and timeline of your project.
          Here's a general sense of how different configurations work.
        </p>
      </div>

      <div class="cost-grid">
        <article class="cost-card">
          <div class="cost-card__header">
            <h3>Discovery</h3>
            <span class="cost-card__duration mono">2-4 weeks</span>
          </div>
          <p class="cost-card__desc">
            Problem framing, user research, technical assessment. Ends with a clear
            brief and recommendation.
          </p>
          <ul class="cost-card__team">
            <li>Core Triad (partial)</li>
            <li>Research specialist</li>
          </ul>
        </article>

        <article class="cost-card cost-card--featured">
          <div class="cost-card__header">
            <h3>Build Sprint</h3>
            <span class="cost-card__duration mono">6-12 weeks</span>
          </div>
          <p class="cost-card__desc">
            Full product development cycle. From validated concept to working MVP
            with real users.
          </p>
          <ul class="cost-card__team">
            <li>Full Core Triad</li>
            <li>Fractional specialists as needed</li>
            <li>Apprentice support</li>
          </ul>
        </article>

        <article class="cost-card">
          <div class="cost-card__header">
            <h3>Venture Partnership</h3>
            <span class="cost-card__duration mono">3-12+ months</span>
          </div>
          <p class="cost-card__desc">
            Co-building relationship with equity or profit-share alignment.
            We become temporary co-founders.
          </p>
          <ul class="cost-card__team">
            <li>Dedicated Core Triad</li>
            <li>Full specialist network</li>
            <li>Strategic advisory</li>
          </ul>
        </article>
      </div>
    </div>
  </section>

  <!-- The Triad Model -->
  <section class="section section--alt">
    <div class="container container--narrow">
      <div class="section-header">
        <span class="section-header__label">Industry Context</span>
        <div class="section-header__rule"></div>
      </div>

      <article class="narrative">
        <h2>A Proven Pattern</h2>

        <p>
          The "product triad" approach is a proven model in modern product development,
          structuring deep collaboration across product, design, and engineering functions.
          Unlike siloed departments, a triad ensures that desirability, viability, and
          feasibility are considered together from day one.
        </p>

        <blockquote>
          <p>
            "Effective product teams work in a balanced, cross-functional triad, ensuring
            products are not only desirable but also viable and feasible."
          </p>
          <cite>— Nielsen Norman Group</cite>
        </blockquote>

        <p>
          This model isn't common in traditional consulting, but it's increasingly recognized
          as the key to effective product teams in agile organizations—and we've made it the
          core of our consultancy.
        </p>
      </article>
    </div>
  </section>

  <!-- CTA -->
  <section class="section cta-section">
    <div class="container">
      <div class="cta-panel panel text-center">
        <p class="eyebrow">See it in action</p>
        <h2>Ready to build with a senior triad?</h2>
        <p class="cta-panel__text">
          Use our Brief Builder to scope your challenge, or explore our engagement models
          to find the right fit for your project.
        </p>
        <div class="cta-panel__actions">
          <a href="/claude/brief" class="btn btn--primary">Start Your Brief</a>
          <a href="/claude/engagements" class="btn btn--secondary">Explore Engagements</a>
        </div>
      </div>
    </div>
  </section>
</ClaudeLayout>

<style>
  /* Page Header */
  .page-header {
    padding: var(--space-2xl) 0 var(--space-xl);
  }

  .page-header h1 {
    margin: var(--space-sm) 0 var(--space-md);
  }

  .page-header__lead {
    font-size: var(--text-xl);
    color: var(--c-muted);
    line-height: 1.5;
  }

  /* Sections */
  .section {
    padding: var(--space-section) 0;
  }

  .section--alt {
    background: var(--c-surface-2);
  }

  /* Model Visual */
  .model-visual {
    display: flex;
    flex-direction: column;
    gap: var(--space-xl);
  }

  .model-layer {
    background: var(--c-surface);
    border: 1px solid var(--c-border);
    border-radius: var(--radius-lg);
    padding: var(--space-xl);
  }

  .model-layer--core {
    border-color: var(--c-accent);
    box-shadow: var(--shadow-lg);
  }

  .model-layer__header {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    margin-bottom: var(--space-md);
  }

  .model-layer__header h2 {
    font-size: var(--text-2xl);
    margin: 0;
  }

  .model-layer__desc {
    color: var(--c-muted);
    font-size: var(--text-lg);
    max-width: 60ch;
    margin-bottom: var(--space-lg);
  }

  /* Triad Visual */
  .triad-visual {
    display: flex;
    justify-content: center;
    gap: var(--space-xl);
    padding: var(--space-lg) 0;
    position: relative;
  }

  .triad-lines {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    color: var(--c-accent);
    display: none;
  }

  .triad-node {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-xs);
    padding: var(--space-lg);
    background: var(--c-surface-2);
    border: 1px solid var(--c-border);
    border-radius: var(--radius-md);
    min-width: 140px;
    transition: transform var(--transition-base), box-shadow var(--transition-base);
  }

  .triad-node:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-md);
  }

  .triad-node__icon {
    width: 40px;
    height: 40px;
    color: var(--c-accent);
  }

  .triad-node__icon svg {
    width: 100%;
    height: 100%;
  }

  .triad-node__label {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 500;
  }

  .triad-node__role {
    font-family: var(--font-accent);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--c-muted);
  }

  /* Specialists */
  .specialists-grid {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
  }

  .specialist-tag {
    padding: 8px 16px;
    background: var(--c-surface-2);
    border: 1px solid var(--c-border);
    border-radius: var(--radius-full);
    font-size: var(--text-sm);
  }

  .specialist-tag--more {
    color: var(--c-muted);
    font-style: italic;
  }

  /* Apprentice Visual */
  .apprentice-visual {
    display: flex;
    gap: var(--space-md);
  }

  .apprentice-node {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    padding: var(--space-md);
    background: var(--c-surface-2);
    border: 1px dashed var(--c-border);
    border-radius: var(--radius-md);
    flex: 1;
    max-width: 150px;
  }

  .apprentice-node span:first-child {
    font-size: var(--text-sm);
    color: var(--c-accent);
  }

  .apprentice-node span:last-child {
    font-size: var(--text-sm);
    color: var(--c-muted);
  }

  /* Benefits */
  .benefits-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }

  .benefit {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-lg);
    padding: var(--space-lg);
    background: var(--c-surface);
    border: 1px solid var(--c-border);
    border-radius: var(--radius-md);
  }

  .benefit__number {
    font-size: var(--text-2xl);
    color: var(--c-accent);
    font-weight: 300;
  }

  .benefit__content h3 {
    font-size: var(--text-xl);
    margin-bottom: var(--space-sm);
  }

  .benefit__content p {
    color: var(--c-muted);
    margin: 0;
  }

  /* Cost Cards */
  .cost-intro {
    max-width: 600px;
    margin-bottom: var(--space-xl);
  }

  .cost-intro h2 {
    margin-bottom: var(--space-sm);
  }

  .cost-intro p {
    color: var(--c-muted);
    font-size: var(--text-lg);
  }

  .cost-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: var(--space-lg);
  }

  .cost-card {
    background: var(--c-surface);
    border: 1px solid var(--c-border);
    border-radius: var(--radius-md);
    padding: var(--space-lg);
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .cost-card--featured {
    border-color: var(--c-accent);
    box-shadow: var(--shadow-md);
  }

  .cost-card__header {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .cost-card__header h3 {
    font-size: var(--text-xl);
    margin: 0;
  }

  .cost-card__duration {
    font-size: var(--text-sm);
    color: var(--c-accent);
  }

  .cost-card__desc {
    color: var(--c-muted);
    font-size: var(--text-sm);
    line-height: 1.6;
    flex: 1;
  }

  .cost-card__team {
    list-style: none;
    padding: 0;
    margin: 0;
    padding-top: var(--space-md);
    border-top: 1px solid var(--c-border);
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    font-size: var(--text-sm);
    color: var(--c-muted);
  }

  .cost-card__team li::before {
    content: "•";
    color: var(--c-accent);
    margin-right: 8px;
  }

  /* Narrative */
  .narrative h2 {
    margin-bottom: var(--space-lg);
  }

  .narrative p {
    font-size: var(--text-lg);
    line-height: 1.7;
    margin-bottom: var(--space-md);
  }

  .narrative blockquote {
    margin: var(--space-lg) 0;
    padding: var(--space-md) var(--space-lg);
    border-left: 4px solid var(--c-accent);
    background: var(--c-surface);
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
  }

  .narrative blockquote p {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-style: italic;
    margin: 0;
  }

  .narrative blockquote cite {
    display: block;
    margin-top: var(--space-sm);
    font-family: var(--font-accent);
    font-size: var(--text-sm);
    font-style: normal;
    color: var(--c-muted);
  }

  /* CTA Section */
  .cta-section {
    padding-bottom: 0;
  }

  .cta-panel.text-center h2 {
    margin: var(--space-xs) 0 var(--space-md);
  }

  .cta-panel__text {
    color: var(--c-muted);
    max-width: 50ch;
    margin: 0 auto var(--space-lg);
  }

  .cta-panel__actions {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: var(--space-sm);
  }

  /* Responsive */
  @media (max-width: 768px) {
    .triad-visual {
      flex-direction: column;
      align-items: center;
    }

    .triad-node {
      width: 100%;
      max-width: 200px;
    }

    .apprentice-visual {
      flex-wrap: wrap;
      justify-content: center;
    }

    .benefit {
      grid-template-columns: 1fr;
      gap: var(--space-sm);
    }

    .benefit__number {
      font-size: var(--text-lg);
    }
  }
</style>
