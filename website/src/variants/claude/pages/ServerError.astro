---
import ClaudeLayout from "../layouts/ClaudeLayout.astro";
---

<ClaudeLayout title="Exhibit Under Repair" description="Our restoration team has been notified of a technical issue.">
  <section class="server-error">
    <div class="container server-error__content">

      <!-- Hanging Wire + Ornate Frame with Animated Logo -->
      <div class="frame-display">
        <div class="frame">
          <div class="frame__mat">
            <div class="frame__inner">
            <svg class="frame__logo" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1000 1000" aria-hidden="true">
              <defs>
                <filter id="se-glow" x="-50%" y="-50%" width="200%" height="200%">
                  <feDropShadow dx="0" dy="0" stdDeviation="1.5" flood-color="#3fb0a2" flood-opacity="1"/>
                </filter>
              </defs>
              <g id="se-char-w" class="char-group">
                <path d="M 298.99111460513524,172.99142565201524 L 316.10090986524955,163.63701994363544 A 25.5,25.5 0 0 1 350.7079419009726,173.77868320359602 L 473.52129643465275,398.4120182103001 A 6,6 0 0 1 471.1350227264267,406.5548492775291 L 454.0252274663124,415.9092549859089 A 25.5,25.5 0 0 1 419.4181954305893,405.7675917259483 L 296.6048408969092,181.1342567192442 A 6,6 0 0 1 298.99111460513524,172.99142565201524 Z" fill="#d96b5a" stroke="#2e2a25" stroke-width="3" filter="url(#se-glow)"/>
                <path d="M 480.5,275.4134636321679 L 500,275.4134636321679 A 25.5,25.5 0 0 1 525.5,300.9134636321679 L 525.5,400.0307379214091 A 6,6 0 0 1 519.5,406.0307379214091 L 500,406.0307379214091 A 25.5,25.5 0 0 1 474.5,380.5307379214091 L 474.5,281.4134636321679 A 6,6 0 0 1 480.5,275.4134636321679 Z" fill="#d96b5a" stroke="#2e2a25" stroke-width="3" filter="url(#se-glow)"/>
                <path d="M 666.7892948746362,154.28261423525575 L 683.8990901347506,163.63701994363555 A 25.5,25.5 0 0 1 694.0407533947113,198.24405197935866 L 571.227398861031,422.8773869860627 A 6,6 0 0 1 563.0845677938021,425.2636606942887 L 545.9747725336877,415.9092549859089 A 25.5,25.5 0 0 1 535.833109273727,381.30222295018575 L 658.6464638074073,156.66888794348176 A 6,6 0 0 1 666.7892948746362,154.28261423525575 Z" fill="#d96b5a" stroke="#2e2a25" stroke-width="3" filter="url(#se-glow)"/>
              </g>
              <g id="se-char-e" class="char-group">
                <path d="M 883.7021753381196,489.4254860356445 L 883.2484306888255,508.920206238644 A 25.5,25.5 0 0 1 857.1619766512108,533.8199435011819 L 601.2171247317448,527.8627609479815 A 6,6 0 0 1 595.3583630229123,521.7247717626605 L 595.8121076722064,502.230051559661 A 25.5,25.5 0 0 1 621.898561709821,477.33031429712315 L 877.843413629287,483.28749685032335 A 6,6 0 0 1 883.7021753381196,489.4254860356445 Z" fill="#d96b5a" stroke="#2e2a25" stroke-width="3" filter="url(#se-glow)"/>
                <path d="M 704.2476458425003,595.4057728101195 L 684.7476458425003,629.1807635577127 A 6,6 0 0 1 676.5514934197937,631.3769159804193 L 590.7134159314406,581.8182788357987 A 25.5,25.5 0 0 1 581.3797681349374,546.9846310392954 L 581.3797681349374,546.9846310392954 A 25.5,25.5 0 0 1 616.2134159314406,537.6509832427922 L 702.0514934197937,587.2096203874129 A 6,6 0 0 1 704.2476458425003,595.4057728101195 Z" fill="#d96b5a" stroke="#2e2a25" stroke-width="3" filter="url(#se-glow)"/>
                <path d="M 699.3493405540748,827.4427738177204 L 682.6932899432546,837.5830883123401 A 6,6 0 0 1 674.4482545261961,835.5782464304323 L 541.3167571404103,616.9020939769285 A 25.5,25.5 0 0 1 549.8373351385187,581.8606934544301 L 566.4933857493389,571.7203789598104 A 6,6 0 0 1 574.7384211663974,573.7252208417183 L 707.8699185521832,792.401373295222 A 25.5,25.5 0 0 1 699.3493405540748,827.4427738177204 Z" fill="#d96b5a" stroke="#2e2a25" stroke-width="3" filter="url(#se-glow)"/>
              </g>
              <g id="se-char-3" class="char-group">
                <path d="M 300.65065944592527,827.4427738177205 L 283.99460883510505,817.3024593231008 A 6,6 0 0 1 281.9897669531972,809.0574239060423 L 415.12126433898294,590.3812714525385 A 25.5,25.5 0 0 1 450.1626648614813,581.8606934544301 L 466.8187154723015,592.0010079490498 A 6,6 0 0 1 468.82355735420936,600.2460433661083 L 335.6920599684236,818.9221958196122 A 25.5,25.5 0 0 1 300.65065944592527,827.4427738177205 Z" fill="#d96b5a" stroke="#2e2a25" stroke-width="3" filter="url(#se-glow)"/>
                <path d="M 305.50235415749967,612.2932681839161 L 305.50235415749967,612.2932681839161 A 25.5,25.5 0 0 1 314.8360019540028,577.4596203874129 L 400.674079442356,527.9009832427922 A 6,6 0 0 1 408.87023186506264,530.0971356654989 L 428.37023186506264,563.872126413092 A 6,6 0 0 1 426.174079442356,572.0682788357987 L 340.3360019540028,621.6269159804193 A 25.5,25.5 0 0 1 305.50235415749967,612.2932681839161 Z" fill="#d96b5a" stroke="#2e2a25" stroke-width="3" filter="url(#se-glow)"/>
                <path d="M 117.2053139604687,528.4149264416436 L 116.75156931117459,508.9202062386441 A 25.5,25.5 0 0 1 141.65130657371242,482.83375220102937 L 397.5961584931784,476.8765696478291 A 6,6 0 0 1 403.73414767849954,482.73533135666156 L 404.18789232779363,502.2300515596611 A 25.5,25.5 0 0 1 379.2881550652558,528.3165055972758 L 123.3433031457898,534.2736881504761 A 6,6 0 0 1 117.2053139604687,528.4149264416436 Z" fill="#d96b5a" stroke="#2e2a25" stroke-width="3" filter="url(#se-glow)"/>
              </g>
            </svg>
            </div>
          </div>
        </div>
      </div>

      <!-- Museum Plaque -->
      <div class="plaque">
        <p class="plaque__eyebrow mono">Error 500</p>
        <h1 class="plaque__heading">Exhibit Under Repair</h1>
        <p class="plaque__body">
          Our restoration team has been notified. The gallery is experiencing
          a technical issue — please return shortly.
        </p>
        <div class="plaque__actions">
          <a href="/claude" class="btn btn--primary">Return to the Collection</a>
          <a href="/claude/contact" class="btn btn--secondary">Report to the Curator</a>
        </div>
      </div>

    </div>
  </section>
</ClaudeLayout>

<style>
  /* ── Page layout ── */
  .server-error {
    padding: var(--space-2xl) 0 var(--space-section);
    min-height: 60vh;
    display: flex;
    align-items: center;
    justify-content: center;
    background:
      radial-gradient(600px circle at 30% 20%, var(--glow-gold), transparent 70%),
      radial-gradient(500px circle at 70% 80%, var(--glow-sage), transparent 60%);
  }

  .server-error__content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-xl);
    text-align: center;
  }

  /* ── Hanging display ── */
  .frame-display {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-top: 48px;
  }

  .frame-display::before {
    content: "";
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 10px;
    height: 10px;
    background: radial-gradient(circle at 40% 35%, #7a7068, #3e3832);
    border-radius: 50%;
    box-shadow: none;
  }

  .frame-display::after {
    content: "";
    position: absolute;
    top: 9px;
    left: 50%;
    transform: translateX(-50%);
    width: 90px;
    height: 38px;
    background:
      linear-gradient(to bottom left, transparent calc(50% - 0.5px), #8a8078 calc(50% - 0.5px), #8a8078 calc(50% + 0.5px), transparent calc(50% + 0.5px)) right / 50% 100% no-repeat,
      linear-gradient(to bottom right, transparent calc(50% - 0.5px), #8a8078 calc(50% - 0.5px), #8a8078 calc(50% + 0.5px), transparent calc(50% + 0.5px)) left / 50% 100% no-repeat;
    pointer-events: none;
  }

  /* ── Ornate frame ── */
  .frame {
    position: relative;
    width: clamp(220px, 40vw, 340px);
    aspect-ratio: 1;
    padding: 24px;
    background: linear-gradient(145deg, #d4a34a, #e4b96c 30%, #f0d090 50%, #e4b96c 70%, #c49340);
    border-radius: 4px;
    box-shadow: none;
    animation: frame-glow 4s ease-in-out infinite;
    transform: rotate(2deg);
  }

  .frame::before,
  .frame::after {
    content: "";
    position: absolute;
    width: 18px;
    height: 18px;
    border: 2px solid rgba(255, 240, 200, 0.5);
    pointer-events: none;
    z-index: 1;
  }

  .frame::before {
    top: 6px;
    left: 6px;
    border-right: none;
    border-bottom: none;
    border-radius: 2px 0 0 0;
  }

  .frame::after {
    bottom: 6px;
    right: 6px;
    border-left: none;
    border-top: none;
    border-radius: 0 0 2px 0;
  }

  @keyframes frame-glow {
    0%, 100% {
      filter: none;
    }
    50% {
      filter: none;
    }
  }

  .frame__mat {
    position: relative;
    width: 100%;
    height: 100%;
    padding: 12px;
    background: #2a2520;
    border-radius: 2px;
    box-shadow: none;
  }

  .frame__mat::before,
  .frame__mat::after {
    content: "";
    position: absolute;
    width: 18px;
    height: 18px;
    border: 2px solid rgba(255, 240, 200, 0.5);
    pointer-events: none;
    z-index: 1;
  }

  .frame__mat::before {
    top: -18px;
    right: -18px;
    border-left: none;
    border-bottom: none;
    border-radius: 0 2px 0 0;
  }

  .frame__mat::after {
    bottom: -18px;
    left: -18px;
    border-right: none;
    border-top: none;
    border-radius: 0 0 0 2px;
  }

  .frame__inner {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    background: var(--c-surface);
    border-radius: 1px;
  }

  .frame__logo {
    width: 85%;
    height: 85%;
  }

  /* ── Flicker / pulse animation (malfunctioning gallery lights) ── */
  #se-char-w {
    animation: flicker-w 3s ease-in-out infinite;
  }
  #se-char-w > path:nth-child(1) { animation: flicker-w 3s ease-in-out infinite; animation-delay: 0s; }
  #se-char-w > path:nth-child(2) { animation: flicker-w 3s ease-in-out infinite; animation-delay: 0.15s; }
  #se-char-w > path:nth-child(3) { animation: flicker-w 3s ease-in-out infinite; animation-delay: 0.3s; }

  @keyframes flicker-w {
    0%, 100% { opacity: 1; }
    20% { opacity: 0.4; }
    25% { opacity: 0.9; }
    30% { opacity: 0.3; }
    35% { opacity: 1; }
    80% { opacity: 1; }
  }

  #se-char-e {
    animation: flicker-e 4s ease-in-out infinite;
  }
  #se-char-e > path:nth-child(1) { animation: flicker-e 4s ease-in-out infinite; animation-delay: 0s; }
  #se-char-e > path:nth-child(2) { animation: flicker-e 4s ease-in-out infinite; animation-delay: 0.2s; }
  #se-char-e > path:nth-child(3) { animation: flicker-e 4s ease-in-out infinite; animation-delay: 0.4s; }

  @keyframes flicker-e {
    0%, 100% { opacity: 1; }
    45% { opacity: 1; }
    50% { opacity: 0.3; }
    52% { opacity: 0.8; }
    55% { opacity: 0.2; }
    60% { opacity: 1; }
  }

  #se-char-3 {
    animation: flicker-3 5s ease-in-out infinite;
  }
  #se-char-3 > path:nth-child(1) { animation: flicker-3 5s ease-in-out infinite; animation-delay: 0s; }
  #se-char-3 > path:nth-child(2) { animation: flicker-3 5s ease-in-out infinite; animation-delay: 0.25s; }
  #se-char-3 > path:nth-child(3) { animation: flicker-3 5s ease-in-out infinite; animation-delay: 0.5s; }

  @keyframes flicker-3 {
    0%, 100% { opacity: 1; }
    70% { opacity: 1; }
    73% { opacity: 0.35; }
    76% { opacity: 0.9; }
    78% { opacity: 0.25; }
    82% { opacity: 1; }
  }

  /* ── Museum plaque ── */
  .plaque {
    max-width: 520px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-sm);
  }

  .plaque__eyebrow {
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: var(--c-accent-gold);
    animation: plaque-enter 0.8s ease-out both;
    animation-delay: 0.2s;
  }

  .plaque__heading {
    font-family: var(--font-display);
    font-size: var(--text-hero);
    font-weight: 400;
    line-height: 1.1;
    margin: 0;
    animation: plaque-enter 0.8s ease-out both;
    animation-delay: 0.4s;
  }

  .plaque__body {
    font-size: var(--text-lg);
    color: var(--c-muted);
    max-width: 44ch;
    line-height: 1.6;
    animation: plaque-enter 0.8s ease-out both;
    animation-delay: 0.6s;
  }

  .plaque__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-sm);
    margin-top: var(--space-md);
    animation: plaque-enter 0.8s ease-out both;
    animation-delay: 0.8s;
  }

  @keyframes plaque-enter {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* ── Responsive ── */
  @media (max-width: 600px) {
    .frame {
      width: clamp(180px, 60vw, 260px);
    }

    .plaque__heading {
      font-size: var(--text-2xl);
    }

    .plaque__body {
      font-size: var(--text-base);
    }

    .plaque__actions {
      flex-direction: column;
      width: 100%;
    }

    .plaque__actions .btn {
      width: 100%;
      text-align: center;
    }
  }
</style>
