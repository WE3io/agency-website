---
import ClaudeLayout from "../layouts/ClaudeLayout.astro";
---

<ClaudeLayout title="Home" description="WE3 - A venture studio that treats every idea like a rare artifact. Small senior teams, big outcomes.">
  <!-- Hero / Opening Vignette -->
  <section class="hero">
    <div class="hero__backdrop" aria-hidden="true"></div>

    <div class="container hero__content">
      <div class="hero__text momentum-hero">
        <p class="eyebrow reveal-up stagger-1">WE3 Venture Studio</p>
        <h1 class="hero__title">
          <span class="reveal-up stagger-2">Small Teams for</span><br />
          <span class="reveal-up stagger-3">Big Challenges</span>
        </h1>
        <p class="hero__lead reveal-up stagger-4">
          We build products and companies with senior triads—product, design, and engineering
          working as one. No armies of juniors. No layers of hierarchy. Just focused expertise
          delivering real outcomes.
        </p>
        <div class="hero__actions reveal-up stagger-5">
          <a href="/claude/brief" class="btn btn--primary">Start Your Brief</a>
          <a href="/claude/story" class="btn btn--secondary">Our Story</a>
        </div>
      </div>

      <aside class="hero__frame">
        <div class="stripe" aria-hidden="true"></div>
        <div class="hero__frame-content">
          <p class="hero__frame-label mono">Collection Status</p>
          <p class="hero__frame-title">Now accepting new projects</p>
          <p class="hero__frame-desc">
            Strategic consulting, co-building startups, and community ventures.
            Three ways to work with us.
          </p>
        </div>
      </aside>
    </div>
  </section>

  <!-- The Problem / Why We Exist -->
  <section class="section reveal-up">
    <div class="container container--narrow">
      <div class="section-header">
        <span class="section-header__label">The Shift</span>
        <div class="section-header__rule"></div>
      </div>

      <div class="problem-statement">
        <h2>Traditional consulting is breaking.</h2>
        <p class="problem-statement__lead">
          Clients no longer want to pay for armies of junior analysts learning on the job.
          They want senior experts who can both <em>think</em> and <em>build</em>.
        </p>
        <p class="problem-statement__text">
          AI handles the grunt work now. What remains valuable is the judgment, creativity,
          and hands-on expertise that only comes from years of building real products.
          WE3 was created for exactly this moment.
        </p>
      </div>
    </div>
  </section>

  <!-- The Model / Three Layers -->
  <section class="section section--alt reveal-up">
    <div class="container">
      <div class="section-header">
        <span class="section-header__label">The Model</span>
        <div class="section-header__rule"></div>
      </div>

      <div class="model-intro">
        <h2>Three layers. Zero waste.</h2>
        <p>
          Every WE3 project is structured around a proven delivery model that balances
          senior expertise with flexibility and mentorship.
        </p>
      </div>

      <div class="model-grid">
        <article class="model-card model-card--primary reveal-up stagger-1">
          <div class="model-card__icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
              <circle cx="12" cy="8" r="4" />
              <path d="M4 20c0-4.4 3.6-8 8-8s8 3.6 8 8" />
            </svg>
          </div>
          <div class="model-card__badge badge">Core</div>
          <h3>Senior Triad</h3>
          <p class="model-card__role">Product · Design · Engineering</p>
          <p>
            Three senior leaders form the nucleus. They own strategy, make decisions,
            and deliver outcomes. No handoffs, no hierarchy—just tight collaboration.
          </p>
        </article>

        <article class="model-card reveal-up stagger-2">
          <div class="model-card__icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
              <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" />
              <circle cx="9" cy="7" r="4" />
              <path d="M22 21v-2a4 4 0 0 0-3-3.87" />
              <path d="M16 3.13a4 4 0 0 1 0 7.75" />
            </svg>
          </div>
          <div class="model-card__badge badge">Flexible</div>
          <h3>Fractional Specialists</h3>
          <p class="model-card__role">Surge capacity · Deep expertise</p>
          <p>
            Need a cloud architect for a week? A UX researcher for user testing?
            Our network of specialists scales teams without bloat.
          </p>
        </article>

        <article class="model-card reveal-up stagger-3">
          <div class="model-card__icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
              <path d="M12 2L2 7l10 5 10-5-10-5z" />
              <path d="M2 17l10 5 10-5" />
              <path d="M2 12l10 5 10-5" />
            </svg>
          </div>
          <div class="model-card__badge badge">Future</div>
          <h3>Apprentice Triad</h3>
          <p class="model-card__role">Next-gen · Mentored growth</p>
          <p>
            One apprentice per discipline shadows the seniors. Real work, real mentorship.
            We're building the next generation while delivering today.
          </p>
        </article>
      </div>

      <div class="model-cta text-center mt-xl">
        <a href="/claude/model" class="btn btn--secondary">Learn more about our model</a>
      </div>
    </div>
  </section>

  <!-- Engagement Modes -->
  <section class="section reveal-up">
    <div class="container">
      <div class="section-header">
        <span class="section-header__label">Engagements</span>
        <div class="section-header__rule"></div>
      </div>

      <div class="engagements-intro">
        <h2>Four ways to work with us.</h2>
        <p>From strategic consulting to venture creation, we flex to your needs.</p>
      </div>

      <div class="engagements-grid">
        <a href="/claude/engagements#consulting" class="engagement-card reveal-up stagger-1">
          <span class="engagement-card__number mono">01</span>
          <h3>Strategic Consulting</h3>
          <p>
            High-stakes problems, hands-on execution. We embed with corporate
            clients and PE firms to drive from insight to implementation.
          </p>
          <span class="engagement-card__link">Learn more &rarr;</span>
        </a>

        <a href="/claude/engagements#co-building" class="engagement-card reveal-up stagger-2">
          <span class="engagement-card__number mono">02</span>
          <h3>Co-Building Startups</h3>
          <p>
            We become temporary co-founders. Time, expertise, sometimes capital—
            with skin in the game through equity or profit-share.
          </p>
          <span class="engagement-card__link">Learn more &rarr;</span>
        </a>

        <a href="/claude/engagements#ventures" class="engagement-card reveal-up stagger-3">
          <span class="engagement-card__number mono">03</span>
          <h3>Venture Creation</h3>
          <p>
            Ideas we originate or source from our community. Validated, incubated,
            and spun out as independent companies.
          </p>
          <span class="engagement-card__link">Learn more &rarr;</span>
        </a>

        <a href="/claude/engagements#community" class="engagement-card reveal-up stagger-4">
          <span class="engagement-card__number mono">04</span>
          <h3>Community</h3>
          <p>
            Open-source tools, resources, and events. We're building a community
            of builders who share our values.
          </p>
          <span class="engagement-card__link">Learn more &rarr;</span>
        </a>
      </div>
    </div>
  </section>

  <!-- Values Teaser -->
  <section class="section section--alt reveal-up">
    <div class="container container--narrow">
      <div class="section-header">
        <span class="section-header__label">Our Values</span>
        <div class="section-header__rule"></div>
      </div>

      <div class="values-teaser">
        <h2>Culture isn't what you say.<br />It's what you do.</h2>

        <ul class="values-list">
          <li><strong>Do What's Right</strong> — Integrity over short-term wins</li>
          <li><strong>Build Together</strong> — Ego takes a backseat to team success</li>
          <li><strong>Stay Curious</strong> — Question everything, learn always</li>
          <li><strong>Choose Courage</strong> — Bold solutions over safe bets</li>
          <li><strong>See With Your Heart</strong> — Empathy drives every decision</li>
          <li><strong>Play Like It Matters</strong> — Work should be meaningful and fun</li>
        </ul>

        <a href="/claude/story" class="btn btn--ghost">Read our full story &rarr;</a>
      </div>
    </div>
  </section>

  <!-- CTA / Brief Builder -->
  <section class="section cta-section reveal-up">
    <div class="container">
      <div class="cta-panel panel">
        <div class="cta-panel__content">
          <p class="eyebrow">Start here</p>
          <h2>Clarity is our calling card.</h2>
          <p>
            Use our Brief Builder to articulate your challenge. It's free, it's fast,
            and your data stays local. A well-defined brief is the foundation of every
            great project.
          </p>
          <div class="cta-panel__actions">
            <a href="/claude/brief" class="btn btn--primary">Start Your Brief</a>
            <a href="/claude/contact" class="btn btn--secondary">Or just say hello</a>
          </div>
        </div>

        <div class="cta-panel__graphic" aria-hidden="true">
          <div class="cta-graphic-card cta-graphic-card--1">
            <span class="mono">Problem</span>
          </div>
          <div class="cta-graphic-card cta-graphic-card--2">
            <span class="mono">Solution</span>
          </div>
          <div class="cta-graphic-card cta-graphic-card--3">
            <span class="mono">Clarity</span>
          </div>
        </div>
      </div>
    </div>
  </section>
</ClaudeLayout>

<style>
  /* Hero */
  .hero {
    position: relative;
    padding: var(--space-2xl) 0 var(--space-section);
    overflow: hidden;
  }

  .hero__backdrop {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(600px circle at 15% 10%, var(--glow-sage), transparent 70%),
      radial-gradient(500px circle at 90% 5%, var(--glow-gold), transparent 60%);
    opacity: 0.7;
    pointer-events: none;
  }

  .hero__content {
    position: relative;
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: var(--space-xl);
    align-items: end;
  }

  .hero__text h1 {
    margin: var(--space-sm) 0 var(--space-md);
  }

  .hero__lead {
    font-size: var(--text-lg);
    color: var(--c-muted);
    max-width: 50ch;
    margin-bottom: var(--space-lg);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
  }

  .hero__frame {
    background: var(--c-surface);
    border: none;
    border-radius: var(--radius-lg);
    padding: var(--space-md);
    box-shadow: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .hero__frame-content {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .hero__frame-label {
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--c-muted);
  }

  .hero__frame-title {
    font-family: var(--font-display);
    font-size: var(--text-xl);
  }

  .hero__frame-desc {
    font-size: var(--text-sm);
    color: var(--c-muted);
  }

  /* Sections */
  .section {
    padding: var(--space-section) 0;
  }

  .section--alt {
    background: var(--c-surface-2);
  }

  /* Problem Statement */
  .problem-statement h2 {
    margin-bottom: var(--space-md);
  }

  .problem-statement__lead {
    font-size: var(--text-xl);
    line-height: 1.5;
    margin-bottom: var(--space-md);
  }

  .problem-statement__lead em {
    color: var(--c-accent);
    font-style: normal;
  }

  .problem-statement__text {
    color: var(--c-muted);
    font-size: var(--text-lg);
  }

  /* Model */
  .model-intro {
    max-width: 600px;
    margin-bottom: var(--space-xl);
  }

  .model-intro h2 {
    margin-bottom: var(--space-sm);
  }

  .model-intro p {
    color: var(--c-muted);
    font-size: var(--text-lg);
  }

  .model-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: var(--space-lg);
  }

  .model-card {
    background: var(--c-surface);
    border: none;
    border-radius: var(--radius-md);
    padding: var(--space-lg);
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    transition: transform var(--transition-base);
  }

  .model-card:hover {
    transform: translateY(-2px);
    box-shadow: none;
  }

  .model-card--primary {
    border-color: transparent;
  }

  .model-card__icon {
    width: 40px;
    height: 40px;
    color: var(--c-accent);
  }

  .model-card__icon svg {
    width: 100%;
    height: 100%;
  }

  .model-card h3 {
    font-size: var(--text-xl);
    margin-top: var(--space-xs);
  }

  .model-card__role {
    font-family: var(--font-accent);
    font-size: var(--text-sm);
    color: var(--c-muted);
  }

  .model-card p:last-child {
    color: var(--c-muted);
    font-size: var(--text-sm);
    line-height: 1.6;
  }

  /* Engagements */
  .engagements-intro {
    max-width: 600px;
    margin-bottom: var(--space-xl);
  }

  .engagements-intro h2 {
    margin-bottom: var(--space-sm);
  }

  .engagements-intro p {
    color: var(--c-muted);
    font-size: var(--text-lg);
  }

  .engagements-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: var(--space-md);
  }

  .engagement-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    padding: var(--space-lg);
    background: var(--c-surface);
    border: none;
    border-radius: var(--radius-md);
    text-decoration: none;
    color: var(--c-text);
    transition: all var(--transition-base);
  }

  .engagement-card:hover {
    border-color: transparent;
    transform: translateY(-2px);
    box-shadow: none;
    text-decoration: none;
  }

  .engagement-card__number {
    font-size: var(--text-sm);
    color: var(--c-accent);
  }

  .engagement-card h3 {
    font-size: var(--text-xl);
  }

  .engagement-card p {
    color: var(--c-muted);
    font-size: var(--text-sm);
    flex: 1;
  }

  .engagement-card__link {
    font-size: var(--text-sm);
    color: var(--c-accent);
    margin-top: var(--space-xs);
  }

  /* Values */
  .values-teaser h2 {
    margin-bottom: var(--space-lg);
  }

  .values-list {
    list-style: none;
    padding: 0;
    margin: 0 0 var(--space-lg);
    display: grid;
    gap: var(--space-sm);
  }

  .values-list li {
    padding: var(--space-sm) 0;
    border-bottom: 1px solid var(--c-border);
    font-size: var(--text-lg);
  }

  .values-list li strong {
    color: var(--c-accent);
    font-weight: 500;
  }

  /* CTA Section */
  .cta-section {
    padding-bottom: 0;
  }

  .cta-panel {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: var(--space-xl);
    align-items: center;
  }

  .cta-panel__content {
    max-width: 500px;
  }

  .cta-panel__content h2 {
    margin: var(--space-xs) 0 var(--space-md);
  }

  .cta-panel__content p {
    color: var(--c-muted);
    margin-bottom: var(--space-lg);
  }

  .cta-panel__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
  }

  .cta-panel__graphic {
    position: relative;
    width: 200px;
    height: 180px;
  }

  .cta-graphic-card {
    position: absolute;
    padding: var(--space-sm) var(--space-md);
    background: var(--c-surface-2);
    border: none;
    border-radius: var(--radius-sm);
    font-size: var(--text-sm);
    box-shadow: none;
  }

  .cta-graphic-card--1 {
    top: 0;
    left: 0;
    transform: rotate(-3deg);
  }

  .cta-graphic-card--2 {
    top: 50px;
    right: 0;
    transform: rotate(2deg);
  }

  .cta-graphic-card--3 {
    bottom: 0;
    left: 30px;
    transform: rotate(-1deg);
    background: var(--c-accent);
    color: var(--c-button-text);
    border-color: var(--c-accent);
  }

  /* Responsive */
  @media (max-width: 900px) {
    .hero__content {
      grid-template-columns: 1fr;
    }

    .hero__frame {
      max-width: 400px;
    }

    .cta-panel {
      grid-template-columns: 1fr;
    }

    .cta-panel__graphic {
      display: none;
    }
  }
</style>
