---
import ClaudeLayout from "../layouts/ClaudeLayout.astro";
---

<ClaudeLayout title="Brief Builder" description="Define your project brief with WE3's free tool. Get clarity, get a fit check, get started.">
  <!-- Page Header -->
  <section class="page-header">
    <div class="container container--narrow">
      <p class="eyebrow">Clarity as a Service</p>
      <h1>Brief Builder</h1>
      <p class="page-header__lead">
        A well-crafted brief is the foundation of every great project. Answer a few questions,
        and we'll help you articulate your challenge clearly.
      </p>
      <div class="privacy-notice">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
          <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
          <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
        </svg>
        <span>Your data stays local. Nothing is sent to our servers.</span>
      </div>
    </div>
  </section>

  <!-- Brief Builder -->
  <section class="section brief-section">
    <div class="container">
      <div class="brief-container">
        <!-- Progress -->
        <div class="brief-progress">
          <div class="progress-bar">
            <div class="progress-fill" id="progressFill"></div>
          </div>
          <span class="progress-text" id="progressText">Step 1 of 6</span>
        </div>

        <!-- Chat Container -->
        <div class="brief-chat" id="briefChat">
          <!-- Messages will be inserted here -->
        </div>

        <!-- Input Area -->
        <div class="brief-input" id="briefInput">
          <!-- Dynamic input will be inserted here -->
        </div>
      </div>
    </div>
  </section>

  <!-- Results Section (hidden initially) -->
  <section class="section results-section" id="resultsSection" style="display: none;">
    <div class="container">
      <div class="results-container">
        <div class="section-header">
          <span class="section-header__label">Fit Check Results</span>
          <div class="section-header__rule"></div>
        </div>

        <div class="results-grid">
          <!-- Engagement Recommendation -->
          <div class="result-card result-card--primary" id="engagementCard">
            <h3>Recommended Engagement</h3>
            <p class="result-value" id="engagementValue">Consulting</p>
            <p class="result-description" id="engagementDesc"></p>
          </div>

          <!-- Cost Band -->
          <div class="result-card" id="costCard">
            <h3>Cost Band</h3>
            <p class="result-value" id="costLabel">Build</p>
            <p class="result-meta"><span id="costRange">$75k - $200k</span> · <span id="costDuration">2-4 months</span></p>
          </div>

          <!-- Team Shape -->
          <div class="result-card" id="teamCard">
            <h3>Suggested Team</h3>
            <div class="team-list" id="teamList">
              <!-- Team members will be inserted here -->
            </div>
          </div>

          <!-- Confidence -->
          <div class="result-card" id="confidenceCard">
            <h3>Confidence</h3>
            <div class="confidence-meter">
              <div class="confidence-fill" id="confidenceFill"></div>
            </div>
            <p class="result-meta" id="confidenceText">High - Brief is complete</p>
          </div>
        </div>

        <!-- Gaps -->
        <div class="gaps-section" id="gapsSection" style="display: none;">
          <h3>Areas to Clarify</h3>
          <div class="gaps-list" id="gapsList">
            <!-- Gaps will be inserted here -->
          </div>
        </div>

        <!-- Export Actions -->
        <div class="export-actions">
          <button class="btn btn--secondary" id="copyMarkdown">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="18" height="18">
              <rect x="9" y="9" width="13" height="13" rx="2" ry="2"/>
              <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/>
            </svg>
            Copy as Markdown
          </button>
          <button class="btn btn--secondary" id="downloadJSON">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="18" height="18">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
              <polyline points="7 10 12 15 17 10"/>
              <line x1="12" y1="15" x2="12" y2="3"/>
            </svg>
            Download JSON
          </button>
          <button class="btn btn--ghost" id="startOver">
            Start Over
          </button>
        </div>

        <!-- Next Steps -->
        <div class="next-steps panel">
          <h3>Ready for the next step?</h3>
          <p>
            Your brief is ready. Book a call to discuss your project with our team,
            or send us the brief directly.
          </p>
          <div class="next-steps__actions">
            <a href="/claude/contact" class="btn btn--primary">Book a Call</a>
            <a href="mailto:hello@we3.io" class="btn btn--secondary">Email Us</a>
          </div>
        </div>
      </div>
    </div>
  </section>
</ClaudeLayout>

<style>
  /* Page Header */
  .page-header {
    padding: var(--space-2xl) 0 var(--space-lg);
  }

  .page-header h1 {
    margin: var(--space-sm) 0 var(--space-md);
  }

  .page-header__lead {
    font-size: var(--text-xl);
    color: var(--c-muted);
    line-height: 1.5;
    margin-bottom: var(--space-md);
  }

  .privacy-notice {
    display: inline-flex;
    align-items: center;
    gap: var(--space-sm);
    padding: 10px 16px;
    background: var(--c-surface);
    border: 1px solid var(--c-border);
    border-radius: var(--radius-full);
    font-size: var(--text-sm);
    color: var(--c-muted);
  }

  .privacy-notice svg {
    width: 18px;
    height: 18px;
    color: var(--c-accent);
  }

  /* Section */
  .section {
    padding: var(--space-lg) 0 var(--space-section);
  }

  /* Brief Container */
  .brief-container {
    max-width: 700px;
    margin: 0 auto;
  }

  /* Progress */
  .brief-progress {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    margin-bottom: var(--space-lg);
  }

  .progress-bar {
    flex: 1;
    height: 6px;
    background: var(--c-border);
    border-radius: var(--radius-full);
    overflow: hidden;
  }

  .progress-fill {
    height: 100%;
    background: var(--c-accent);
    border-radius: var(--radius-full);
    transition: width 0.3s ease;
    width: 16.67%;
  }

  .progress-text {
    font-family: var(--font-accent);
    font-size: var(--text-sm);
    color: var(--c-muted);
    white-space: nowrap;
  }

  /* Chat */
  .brief-chat {
    background: var(--c-surface);
    border: 1px solid var(--c-border);
    border-radius: var(--radius-lg);
    min-height: 300px;
    max-height: 500px;
    overflow-y: auto;
    padding: var(--space-lg);
    margin-bottom: var(--space-md);
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .chat-message {
    max-width: 85%;
    animation: fadeIn 0.3s ease;
  }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .chat-message--system {
    align-self: flex-start;
  }

  .chat-message--user {
    align-self: flex-end;
  }

  .chat-bubble {
    padding: var(--space-md);
    border-radius: var(--radius-md);
  }

  .chat-message--system .chat-bubble {
    background: var(--c-surface-2);
    border: 1px solid var(--c-border);
  }

  .chat-message--user .chat-bubble {
    background: var(--c-accent);
    color: var(--c-button-text);
  }

  .chat-bubble__question {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    margin-bottom: var(--space-xs);
  }

  .chat-bubble__help {
    font-size: var(--text-sm);
    opacity: 0.8;
  }

  /* Input */
  .brief-input {
    background: var(--c-surface);
    border: 1px solid var(--c-border);
    border-radius: var(--radius-md);
    padding: var(--space-md);
  }

  .input-wrapper {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .input-wrapper textarea {
    width: 100%;
    min-height: 100px;
    padding: var(--space-sm);
    border: 1px solid var(--c-border);
    border-radius: var(--radius-sm);
    background: var(--c-bg);
    color: var(--c-text);
    font-family: var(--font-body);
    font-size: var(--text-base);
    resize: vertical;
  }

  .input-wrapper textarea:focus {
    outline: none;
    border-color: var(--c-accent);
    box-shadow: 0 0 0 3px var(--glow-sage);
  }

  .input-wrapper select {
    width: 100%;
    padding: var(--space-sm);
    border: 1px solid var(--c-border);
    border-radius: var(--radius-sm);
    background: var(--c-bg);
    color: var(--c-text);
    font-family: var(--font-body);
    font-size: var(--text-base);
  }

  .input-wrapper select:focus {
    outline: none;
    border-color: var(--c-accent);
  }

  .input-actions {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .input-actions button {
    cursor: pointer;
  }

  .skip-btn {
    font-size: var(--text-sm);
    color: var(--c-muted);
    background: none;
    border: none;
    cursor: pointer;
  }

  .skip-btn:hover {
    color: var(--c-text);
  }

  /* Results */
  .results-container {
    max-width: 900px;
    margin: 0 auto;
  }

  .results-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-md);
    margin-bottom: var(--space-xl);
  }

  .result-card {
    background: var(--c-surface);
    border: 1px solid var(--c-border);
    border-radius: var(--radius-md);
    padding: var(--space-lg);
  }

  .result-card--primary {
    border-color: var(--c-accent);
    grid-column: span 2;
  }

  .result-card h3 {
    font-family: var(--font-accent);
    font-size: var(--text-sm);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--c-muted);
    margin-bottom: var(--space-sm);
    font-weight: 400;
  }

  .result-value {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    color: var(--c-accent);
    margin: 0;
  }

  .result-description {
    color: var(--c-muted);
    font-size: var(--text-sm);
    margin-top: var(--space-xs);
  }

  .result-meta {
    font-size: var(--text-sm);
    color: var(--c-muted);
    margin-top: var(--space-xs);
  }

  /* Team List */
  .team-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .team-member {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    font-size: var(--text-sm);
  }

  .team-member__type {
    font-family: var(--font-accent);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--c-muted);
    width: 70px;
  }

  .team-member--core .team-member__type {
    color: var(--c-accent);
  }

  /* Confidence Meter */
  .confidence-meter {
    height: 8px;
    background: var(--c-border);
    border-radius: var(--radius-full);
    overflow: hidden;
    margin-bottom: var(--space-sm);
  }

  .confidence-fill {
    height: 100%;
    background: var(--c-accent);
    border-radius: var(--radius-full);
    transition: width 0.3s ease;
  }

  .confidence-fill[data-level="high"] { width: 100%; }
  .confidence-fill[data-level="medium"] { width: 66%; background: var(--c-accent-gold); }
  .confidence-fill[data-level="low"] { width: 33%; background: var(--c-accent-terracotta); }

  /* Gaps */
  .gaps-section {
    margin-bottom: var(--space-xl);
  }

  .gaps-section h3 {
    font-size: var(--text-lg);
    margin-bottom: var(--space-md);
  }

  .gaps-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .gap-item {
    padding: var(--space-md);
    background: var(--c-surface);
    border: 1px solid var(--c-border);
    border-radius: var(--radius-sm);
    border-left: 4px solid var(--c-accent-gold);
  }

  .gap-item--critical {
    border-left-color: var(--c-accent-terracotta);
  }

  .gap-item__message {
    font-weight: 500;
    margin-bottom: var(--space-xs);
  }

  .gap-item__suggestion {
    font-size: var(--text-sm);
    color: var(--c-muted);
  }

  /* Export Actions */
  .export-actions {
    display: flex;
    gap: var(--space-sm);
    margin-bottom: var(--space-xl);
  }

  .export-actions .btn {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
  }

  /* Next Steps */
  .next-steps {
    text-align: center;
  }

  .next-steps h3 {
    margin-bottom: var(--space-sm);
  }

  .next-steps p {
    color: var(--c-muted);
    margin-bottom: var(--space-lg);
  }

  .next-steps__actions {
    display: flex;
    justify-content: center;
    gap: var(--space-sm);
  }

  /* Responsive */
  @media (max-width: 768px) {
    .results-grid {
      grid-template-columns: 1fr;
    }

    .result-card--primary {
      grid-column: auto;
    }

    .export-actions {
      flex-wrap: wrap;
    }
  }
</style>

<script>
  // Brief Engine - Inline for Astro static build
  const BRIEF_STEPS = [
    {
      id: 'problem',
      question: "What problem are you trying to solve?",
      type: 'textarea',
      placeholder: "Describe the challenge you're facing. What's not working? What opportunity are you trying to capture?",
      required: true,
      helpText: "Be specific about the pain points and their impact on your business.",
    },
    {
      id: 'users',
      question: "Who are the users or stakeholders?",
      type: 'textarea',
      placeholder: "Who will use this solution? Who cares about the outcome? Who has influence over decisions?",
      required: true,
      helpText: "Understanding your users helps us design the right solution.",
    },
    {
      id: 'successCriteria',
      question: "What does success look like?",
      type: 'textarea',
      placeholder: "How will you know this worked? What metrics matter? What's the ideal outcome in 6-12 months?",
      required: true,
      helpText: "Clear success criteria help us stay focused on what matters.",
    },
    {
      id: 'constraints',
      question: "What constraints should we know about?",
      type: 'textarea',
      placeholder: "Technical requirements, compliance needs, existing systems, team capacity, political realities...",
      required: false,
      helpText: "No constraint is too small to mention. They often shape the solution.",
    },
    {
      id: 'budgetRange',
      question: "What's your budget range?",
      type: 'select',
      options: [
        { value: 'exploring', label: "Just exploring (< $25k)" },
        { value: 'small', label: "Small project ($25k - $75k)" },
        { value: 'medium', label: "Medium engagement ($75k - $200k)" },
        { value: 'large', label: "Large engagement ($200k - $500k)" },
        { value: 'enterprise', label: "Enterprise ($500k+)" },
        { value: 'equity', label: "Equity/revenue share (co-building)" },
        { value: 'unsure', label: "Not sure yet" },
      ],
      required: true,
      helpText: "This helps us recommend the right engagement model.",
    },
    {
      id: 'timeline',
      question: "What's your timeline?",
      type: 'select',
      options: [
        { value: 'urgent', label: "Urgent (< 4 weeks)" },
        { value: 'soon', label: "Soon (1-3 months)" },
        { value: 'planned', label: "Planned (3-6 months)" },
        { value: 'flexible', label: "Flexible (6+ months)" },
        { value: 'unsure', label: "Not sure yet" },
      ],
      required: true,
      helpText: "Timeline affects team composition and engagement structure.",
    },
  ];

  // State
  let currentStep = 0;
  const responses: Record<string, string> = {};

  // DOM Elements
  const chat = document.getElementById('briefChat')!;
  const inputContainer = document.getElementById('briefInput')!;
  const progressFill = document.getElementById('progressFill')!;
  const progressText = document.getElementById('progressText')!;
  const resultsSection = document.getElementById('resultsSection')!;

  // Initialize
  function init() {
    showStep(0);
  }

  // Show a step
  function showStep(stepIndex: number) {
    const step = BRIEF_STEPS[stepIndex];
    if (!step) {
      showResults();
      return;
    }

    currentStep = stepIndex;
    updateProgress();

    // Add system message
    addMessage(step.question, 'system', step.helpText);

    // Show input
    renderInput(step);
  }

  // Update progress
  function updateProgress() {
    const percent = ((currentStep + 1) / BRIEF_STEPS.length) * 100;
    progressFill.style.width = `${percent}%`;
    progressText.textContent = `Step ${currentStep + 1} of ${BRIEF_STEPS.length}`;
  }

  // Add message to chat
  function addMessage(content: string, type: 'system' | 'user', helpText?: string) {
    const msg = document.createElement('div');
    msg.className = `chat-message chat-message--${type}`;

    let html = `<div class="chat-bubble">`;
    if (type === 'system') {
      html += `<p class="chat-bubble__question">${content}</p>`;
      if (helpText) {
        html += `<p class="chat-bubble__help">${helpText}</p>`;
      }
    } else {
      html += `<p>${content}</p>`;
    }
    html += `</div>`;

    msg.innerHTML = html;
    chat.appendChild(msg);
    chat.scrollTop = chat.scrollHeight;
  }

  // Render input
  function renderInput(step: typeof BRIEF_STEPS[0]) {
    let html = '<div class="input-wrapper">';

    if (step.type === 'textarea') {
      html += `<textarea id="inputField" placeholder="${step.placeholder || ''}" autofocus></textarea>`;
    } else if (step.type === 'select' && step.options) {
      html += `<select id="inputField">
        <option value="">Select an option...</option>
        ${step.options.map(o => `<option value="${o.value}">${o.label}</option>`).join('')}
      </select>`;
    }

    html += `<div class="input-actions">`;
    if (!step.required) {
      html += `<button class="skip-btn" onclick="skipStep()">Skip this question</button>`;
    } else {
      html += `<span></span>`;
    }
    html += `<button class="btn btn--primary" onclick="submitStep()">Continue</button>`;
    html += `</div></div>`;

    inputContainer.innerHTML = html;

    // Focus and enter key
    const field = document.getElementById('inputField') as HTMLTextAreaElement | HTMLSelectElement;
    field?.focus();

    if (step.type === 'textarea') {
      field?.addEventListener('keydown', (e: KeyboardEvent) => {
        if (e.key === 'Enter' && !e.shiftKey) {
          e.preventDefault();
          submitStep();
        }
      });
    } else if (step.type === 'select') {
      field?.addEventListener('change', submitStep);
    }
  }

  // Submit step
  function submitStep() {
    const field = document.getElementById('inputField') as HTMLTextAreaElement | HTMLSelectElement;
    const value = field?.value?.trim();
    const step = BRIEF_STEPS[currentStep];

    if (step.required && !value) {
      field?.focus();
      return;
    }

    // Store response
    responses[step.id] = value;

    // Show user response
    if (value) {
      const displayValue = step.type === 'select'
        ? step.options?.find(o => o.value === value)?.label || value
        : value;
      addMessage(displayValue, 'user');
    } else {
      addMessage('(Skipped)', 'user');
    }

    // Next step
    showStep(currentStep + 1);
  }

  // Skip step
  (window as any).skipStep = function() {
    responses[BRIEF_STEPS[currentStep].id] = '';
    addMessage('(Skipped)', 'user');
    showStep(currentStep + 1);
  };

  // Make submitStep available globally
  (window as any).submitStep = submitStep;

  // Show results
  function showResults() {
    inputContainer.innerHTML = '<p class="text-center text-muted">Generating your fit check...</p>';

    setTimeout(() => {
      document.querySelector('.brief-section')!.setAttribute('style', 'display: none;');
      resultsSection.style.display = 'block';

      const fitCheck = calculateFitCheck(responses);
      renderResults(fitCheck);
    }, 500);
  }

  // Calculate fit check
  function calculateFitCheck(data: Record<string, string>) {
    const notes: string[] = [];

    // Determine engagement type
    let engagement = 'consulting';
    if (data.budgetRange === 'equity') {
      engagement = 'co-building';
      notes.push("Equity-based engagement suggests a co-building partnership.");
    } else if (data.budgetRange === 'exploring') {
      engagement = 'community';
      notes.push("For exploration-stage projects, we recommend starting with our free resources.");
    }

    // Crew shape
    const crewShape = {
      core: ['Product Strategist'],
      fractional: [] as string[],
      apprentices: false,
    };

    if (['medium', 'large', 'enterprise'].includes(data.budgetRange)) {
      crewShape.core = ['Product Strategist', 'Design Lead', 'Engineering Lead'];
      crewShape.apprentices = true;
    } else if (data.budgetRange === 'small') {
      crewShape.core = ['Product Strategist', 'Design Lead'];
    }

    // Fractional based on keywords
    const problem = (data.problem || '').toLowerCase();
    if (problem.includes('data') || problem.includes('analytics')) crewShape.fractional.push('Data Specialist');
    if (problem.includes('mobile') || problem.includes('app')) crewShape.fractional.push('Mobile Developer');
    if (problem.includes('ai') || problem.includes('ml')) crewShape.fractional.push('ML Engineer');

    // Cost band
    const costBands: Record<string, { label: string; range: string; duration: string }> = {
      exploring: { label: 'Discovery', range: '< $25k', duration: '2-4 weeks' },
      small: { label: 'Sprint', range: '$25k - $75k', duration: '4-8 weeks' },
      medium: { label: 'Build', range: '$75k - $200k', duration: '2-4 months' },
      large: { label: 'Program', range: '$200k - $500k', duration: '4-8 months' },
      enterprise: { label: 'Enterprise', range: '$500k+', duration: '6-12+ months' },
      equity: { label: 'Partnership', range: 'Equity/Revenue Share', duration: '3-12+ months' },
      unsure: { label: 'To Be Determined', range: "Let's discuss", duration: 'Varies' },
    };
    const costBand = costBands[data.budgetRange] || costBands.unsure;

    // Gaps
    const gaps: Array<{ type: string; field: string; message: string; suggestion: string }> = [];
    if (data.problem && data.problem.length < 50) {
      gaps.push({
        type: 'warning',
        field: 'problem',
        message: "Problem description seems brief.",
        suggestion: "Add more context about business impact and root causes.",
      });
    }
    if (data.successCriteria && !/\d+|%|increase|decrease|reduce|improve/i.test(data.successCriteria)) {
      gaps.push({
        type: 'warning',
        field: 'successCriteria',
        message: "Success criteria could be more specific.",
        suggestion: "Consider adding measurable outcomes.",
      });
    }
    if (data.budgetRange === 'unsure') {
      gaps.push({
        type: 'warning',
        field: 'budgetRange',
        message: "Budget range is uncertain.",
        suggestion: "A rough range helps us recommend the right engagement model.",
      });
    }

    // Confidence
    let confidence = 'high';
    if (gaps.some(g => g.type === 'critical')) confidence = 'low';
    else if (gaps.length > 2) confidence = 'medium';

    return { engagement, crewShape, costBand, confidence, notes, gaps };
  }

  // Render results
  function renderResults(fitCheck: ReturnType<typeof calculateFitCheck>) {
    // Engagement
    const engagementLabels: Record<string, string> = {
      consulting: 'Strategic Consulting',
      'co-building': 'Co-Building Partnership',
      venture: 'Venture Creation',
      community: 'Community Resources',
    };
    document.getElementById('engagementValue')!.textContent = engagementLabels[fitCheck.engagement] || fitCheck.engagement;
    document.getElementById('engagementDesc')!.textContent = fitCheck.notes.join(' ');

    // Cost band
    document.getElementById('costLabel')!.textContent = fitCheck.costBand.label;
    document.getElementById('costRange')!.textContent = fitCheck.costBand.range;
    document.getElementById('costDuration')!.textContent = fitCheck.costBand.duration;

    // Team
    const teamList = document.getElementById('teamList')!;
    teamList.innerHTML = '';
    fitCheck.crewShape.core.forEach(member => {
      teamList.innerHTML += `<div class="team-member team-member--core"><span class="team-member__type">Core</span>${member}</div>`;
    });
    fitCheck.crewShape.fractional.forEach(member => {
      teamList.innerHTML += `<div class="team-member"><span class="team-member__type">Fractional</span>${member}</div>`;
    });
    if (fitCheck.crewShape.apprentices) {
      teamList.innerHTML += `<div class="team-member"><span class="team-member__type">Support</span>Apprentice Triad</div>`;
    }

    // Confidence
    const confidenceFill = document.getElementById('confidenceFill')!;
    confidenceFill.setAttribute('data-level', fitCheck.confidence);
    const confidenceLabels: Record<string, string> = {
      high: 'High - Brief is complete',
      medium: 'Medium - Some areas to clarify',
      low: 'Low - Missing key information',
    };
    document.getElementById('confidenceText')!.textContent = confidenceLabels[fitCheck.confidence];

    // Gaps
    if (fitCheck.gaps.length > 0) {
      const gapsSection = document.getElementById('gapsSection')!;
      gapsSection.style.display = 'block';
      const gapsList = document.getElementById('gapsList')!;
      gapsList.innerHTML = fitCheck.gaps.map(gap => `
        <div class="gap-item ${gap.type === 'critical' ? 'gap-item--critical' : ''}">
          <p class="gap-item__message">${gap.message}</p>
          <p class="gap-item__suggestion">${gap.suggestion}</p>
        </div>
      `).join('');
    }

    // Export buttons
    document.getElementById('copyMarkdown')!.addEventListener('click', () => {
      const md = generateMarkdown(responses, fitCheck);
      navigator.clipboard.writeText(md).then(() => {
        alert('Copied to clipboard!');
      });
    });

    document.getElementById('downloadJSON')!.addEventListener('click', () => {
      const json = JSON.stringify({ brief: responses, fitCheck, generatedAt: new Date().toISOString() }, null, 2);
      const blob = new Blob([json], { type: 'application/json' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = 'we3-brief.json';
      a.click();
      URL.revokeObjectURL(url);
    });

    document.getElementById('startOver')!.addEventListener('click', () => {
      location.reload();
    });
  }

  // Generate Markdown
  function generateMarkdown(data: Record<string, string>, fitCheck: ReturnType<typeof calculateFitCheck>) {
    const budgetLabel = BRIEF_STEPS.find(s => s.id === 'budgetRange')?.options?.find(o => o.value === data.budgetRange)?.label || data.budgetRange;
    const timelineLabel = BRIEF_STEPS.find(s => s.id === 'timeline')?.options?.find(o => o.value === data.timeline)?.label || data.timeline;

    return `# Project Brief

## Problem Statement
${data.problem || 'Not provided'}

## Users & Stakeholders
${data.users || 'Not provided'}

## Success Criteria
${data.successCriteria || 'Not provided'}

## Constraints
${data.constraints || 'None specified'}

## Budget Range
${budgetLabel}

## Timeline
${timelineLabel}

---

## Fit Check Summary

**Recommended Engagement:** ${fitCheck.engagement}
**Cost Band:** ${fitCheck.costBand.label} (${fitCheck.costBand.range}, ${fitCheck.costBand.duration})
**Team:** ${fitCheck.crewShape.core.join(', ')}${fitCheck.crewShape.fractional.length ? ' + ' + fitCheck.crewShape.fractional.join(', ') : ''}

---
Generated by WE3 Brief Builder
`;
  }

  // Init
  init();
</script>
