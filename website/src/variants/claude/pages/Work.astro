---
import ClaudeLayout from "../layouts/ClaudeLayout.astro";

// Placeholder case studies - these would typically come from content collections
const caseStudies = [
  {
    slug: "fintech-platform",
    title: "Fintech Platform Redesign",
    client: "Series B Fintech Startup",
    category: "Co-Building",
    description: "Transformed a legacy payment platform into a modern, user-centric experience that increased conversion by 40%.",
    tags: ["Product Strategy", "UX Design", "Engineering"],
    featured: true,
  },
  {
    slug: "enterprise-dashboard",
    title: "Enterprise Analytics Dashboard",
    client: "Fortune 500 Retailer",
    category: "Consulting",
    description: "Built an internal analytics platform that reduced decision-making time from weeks to hours.",
    tags: ["Data Visualization", "React", "Enterprise"],
    featured: true,
  },
  {
    slug: "healthtech-mvp",
    title: "HealthTech MVP Launch",
    client: "Seed-Stage Startup",
    category: "Co-Building",
    description: "Took a healthcare compliance tool from concept to market in 12 weeks with validated product-market fit.",
    tags: ["MVP Development", "Healthcare", "Compliance"],
    featured: false,
  },
  {
    slug: "ai-integration",
    title: "AI Integration Strategy",
    client: "Private Equity Portfolio Co.",
    category: "Consulting",
    description: "Developed and implemented an AI strategy that automated 60% of manual processes across three portfolio companies.",
    tags: ["AI/ML", "Strategy", "Automation"],
    featured: false,
  },
];
---

<ClaudeLayout title="Work" description="Case studies and projects from WE3 - see how our senior triads deliver real outcomes.">
  <!-- Page Header -->
  <section class="page-header">
    <div class="container container--narrow">
      <p class="eyebrow">Proof of Work</p>
      <h1>Ideas Made Real</h1>
      <p class="page-header__lead">
        We don't just talk—we build. Here are some of the projects where our senior triads
        have delivered real outcomes for real clients.
      </p>
    </div>
  </section>

  <!-- Featured Work -->
  <section class="section">
    <div class="container">
      <div class="section-header">
        <span class="section-header__label">Featured</span>
        <div class="section-header__rule"></div>
      </div>

      <div class="featured-grid">
        {caseStudies.filter(c => c.featured).map((study, i) => (
          <article class={`case-card case-card--featured ${i === 0 ? 'case-card--large' : ''}`}>
            <div class="case-card__image" aria-hidden="true">
              <div class="case-card__placeholder"></div>
            </div>
            <div class="case-card__content">
              <div class="case-card__meta">
                <span class="badge">{study.category}</span>
                <span class="case-card__client mono">{study.client}</span>
              </div>
              <h3>{study.title}</h3>
              <p>{study.description}</p>
              <div class="case-card__tags">
                {study.tags.map(tag => (
                  <span class="tag">{tag}</span>
                ))}
              </div>
              <span class="case-card__link">View case study &rarr;</span>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- All Work -->
  <section class="section section--alt">
    <div class="container">
      <div class="section-header">
        <span class="section-header__label">More Work</span>
        <div class="section-header__rule"></div>
      </div>

      <div class="work-grid">
        {caseStudies.filter(c => !c.featured).map((study) => (
          <article class="case-card">
            <div class="case-card__content">
              <div class="case-card__meta">
                <span class="badge">{study.category}</span>
                <span class="case-card__client mono">{study.client}</span>
              </div>
              <h3>{study.title}</h3>
              <p>{study.description}</p>
              <div class="case-card__tags">
                {study.tags.map(tag => (
                  <span class="tag">{tag}</span>
                ))}
              </div>
              <span class="case-card__link">View case study &rarr;</span>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Stats / Social Proof -->
  <section class="section">
    <div class="container">
      <div class="stats-grid">
        <div class="stat">
          <span class="stat__number">50+</span>
          <span class="stat__label">Projects Delivered</span>
        </div>
        <div class="stat">
          <span class="stat__number">12</span>
          <span class="stat__label">Ventures Launched</span>
        </div>
        <div class="stat">
          <span class="stat__number">95%</span>
          <span class="stat__label">Client Satisfaction</span>
        </div>
        <div class="stat">
          <span class="stat__number">3</span>
          <span class="stat__label">Successful Exits</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Industries -->
  <section class="section section--alt">
    <div class="container container--narrow">
      <div class="section-header">
        <span class="section-header__label">Industries</span>
        <div class="section-header__rule"></div>
      </div>

      <div class="industries-content">
        <h2>We go where the problems are interesting.</h2>
        <p>
          While we're generalists at heart, we've developed deep expertise in
          certain domains through repeated engagements.
        </p>

        <div class="industries-grid">
          <div class="industry-tag">Fintech</div>
          <div class="industry-tag">Healthcare</div>
          <div class="industry-tag">Enterprise SaaS</div>
          <div class="industry-tag">E-commerce</div>
          <div class="industry-tag">Education</div>
          <div class="industry-tag">Climate Tech</div>
          <div class="industry-tag">B2B Platforms</div>
          <div class="industry-tag">Developer Tools</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Testimonial -->
  <section class="section">
    <div class="container container--narrow">
      <blockquote class="testimonial">
        <p>
          "WE3 doesn't just deliver a strategy deck and walk away. Their team embedded
          with us, built alongside us, and stayed until we had something real. That's
          rare in consulting."
        </p>
        <footer>
          <cite>
            <strong>Sarah Chen</strong>
            <span>CTO, Fintech Startup (Series B)</span>
          </cite>
        </footer>
      </blockquote>
    </div>
  </section>

  <!-- CTA -->
  <section class="section cta-section">
    <div class="container">
      <div class="cta-panel panel text-center">
        <p class="eyebrow">Your project next?</p>
        <h2>Let's build something together.</h2>
        <p class="cta-panel__text">
          Use our Brief Builder to articulate your challenge, and we'll help you figure
          out the best approach.
        </p>
        <div class="cta-panel__actions">
          <a href="/claude/brief" class="btn btn--primary">Start Your Brief</a>
          <a href="/claude/contact" class="btn btn--secondary">Get in Touch</a>
        </div>
      </div>
    </div>
  </section>
</ClaudeLayout>

<style>
  /* Page Header */
  .page-header {
    padding: var(--space-2xl) 0 var(--space-xl);
  }

  .page-header h1 {
    margin: var(--space-sm) 0 var(--space-md);
  }

  .page-header__lead {
    font-size: var(--text-xl);
    color: var(--c-muted);
    line-height: 1.5;
  }

  /* Sections */
  .section {
    padding: var(--space-section) 0;
  }

  .section--alt {
    background: var(--c-surface-2);
  }

  /* Featured Grid */
  .featured-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-lg);
  }

  .case-card--large {
    grid-row: span 2;
  }

  /* Case Card */
  .case-card {
    background: var(--c-surface);
    border: 1px solid var(--c-border);
    border-radius: var(--radius-md);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: transform var(--transition-base), box-shadow var(--transition-base);
    cursor: pointer;
  }

  .case-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-lg);
  }

  .case-card__image {
    position: relative;
    aspect-ratio: 16 / 9;
    background: var(--c-surface-2);
  }

  .case-card--large .case-card__image {
    aspect-ratio: 4 / 3;
  }

  .case-card__placeholder {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(135deg, var(--c-surface-2) 25%, transparent 25%),
      linear-gradient(-135deg, var(--c-surface-2) 25%, transparent 25%),
      linear-gradient(45deg, var(--c-surface-2) 25%, transparent 25%),
      linear-gradient(-45deg, var(--c-surface-2) 25%, transparent 25%);
    background-size: 20px 20px;
    background-color: var(--c-bg);
    opacity: 0.5;
  }

  .case-card__content {
    padding: var(--space-lg);
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    flex: 1;
  }

  .case-card__meta {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
  }

  .case-card__client {
    font-size: var(--text-xs);
    color: var(--c-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .case-card h3 {
    font-size: var(--text-xl);
    margin: 0;
  }

  .case-card--large h3 {
    font-size: var(--text-2xl);
  }

  .case-card p {
    color: var(--c-muted);
    font-size: var(--text-sm);
    line-height: 1.6;
    flex: 1;
  }

  .case-card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .tag {
    font-size: var(--text-xs);
    color: var(--c-muted);
    padding: 4px 8px;
    background: var(--c-surface-2);
    border-radius: var(--radius-sm);
  }

  .case-card__link {
    font-size: var(--text-sm);
    color: var(--c-accent);
    margin-top: var(--space-xs);
  }

  /* Work Grid */
  .work-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: var(--space-lg);
  }

  .work-grid .case-card__image {
    display: none;
  }

  /* Stats */
  .stats-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-lg);
    text-align: center;
  }

  .stat {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .stat__number {
    font-family: var(--font-display);
    font-size: var(--text-hero);
    font-weight: 500;
    color: var(--c-accent);
    line-height: 1;
  }

  .stat__label {
    font-family: var(--font-accent);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--c-muted);
  }

  /* Industries */
  .industries-content h2 {
    margin-bottom: var(--space-sm);
  }

  .industries-content > p {
    font-size: var(--text-lg);
    color: var(--c-muted);
    margin-bottom: var(--space-xl);
  }

  .industries-grid {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
  }

  .industry-tag {
    padding: 10px 18px;
    background: var(--c-surface);
    border: 1px solid var(--c-border);
    border-radius: var(--radius-full);
    font-size: var(--text-sm);
  }

  /* Testimonial */
  .testimonial {
    margin: 0;
    padding: var(--space-xl);
    background: var(--c-surface);
    border: 1px solid var(--c-border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-md);
  }

  .testimonial p {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-style: italic;
    line-height: 1.4;
    margin: 0 0 var(--space-lg);
  }

  .testimonial footer {
    display: flex;
    align-items: center;
    gap: var(--space-md);
  }

  .testimonial cite {
    font-style: normal;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .testimonial cite strong {
    font-weight: 500;
  }

  .testimonial cite span {
    font-size: var(--text-sm);
    color: var(--c-muted);
  }

  /* CTA Section */
  .cta-section {
    padding-bottom: 0;
  }

  .cta-panel.text-center h2 {
    margin: var(--space-xs) 0 var(--space-md);
  }

  .cta-panel__text {
    color: var(--c-muted);
    max-width: 50ch;
    margin: 0 auto var(--space-lg);
  }

  .cta-panel__actions {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: var(--space-sm);
  }

  /* Responsive */
  @media (max-width: 900px) {
    .featured-grid {
      grid-template-columns: 1fr;
    }

    .case-card--large {
      grid-row: auto;
    }

    .stats-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 600px) {
    .stats-grid {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-md);
    }

    .stat__number {
      font-size: var(--text-3xl);
    }
  }
</style>
