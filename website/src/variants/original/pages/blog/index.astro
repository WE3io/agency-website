---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const posts = await getCollection("posts", ({ id }) => id.startsWith("original/"));
---
<BaseLayout title="Blog">
  <h1>Blog</h1>
  <ul>
    {posts.map((post) => (
      <li>
        <a href={`/original/blog/${post.slug.replace("original/", "")}`}>{post.data.title}</a>
        <time>{post.data.date}</time>
      </li>
    ))}
  </ul>
</BaseLayout>
