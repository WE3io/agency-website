---
import BaseLayout from "../layouts/BaseLayout.astro";
import TeamModel from "../components/TeamModel.astro";
import StoryVignette from "../components/StoryVignette.astro";
import BriefBuilder from "../components/BriefBuilder.astro";
import CommunityApprentice from "../components/CommunityApprentice.astro";
import EngagementModes from "../components/EngagementModes.astro";
---

<BaseLayout title="Home">
    <main class="container">
        <StoryVignette />
        
        <section class="intro-text">
            <p class="eyebrow">WE3 / MISSION</p>
            <h1>Small Teams for Big Challenges.</h1>
            <p class="lead">
                We are a venture studio that treats every idea like a rare artifact. 
                Warm, curious, and confidently crafted builds.
            </p>
        </section>

        <TeamModel />

        <EngagementModes />

        <CommunityApprentice />
        
        <section class="builder-section">
            <h2 style="text-align: center; margin-bottom: 3rem;">Ready to build? Let's check the fit.</h2>
            <BriefBuilder />
        </section>
    </main>
</BaseLayout>

<style>
    .intro-text {
        margin-bottom: var(--spacing-large);
        max-width: 65ch;
    }
    .eyebrow {
        font-family: var(--typography-font-family-mono);
        color: var(--ag-accent);
        letter-spacing: 0.2em;
        font-size: 0.75rem;
    }
    .lead {
        font-size: var(--typography-font-size-large);
        opacity: 0.8;
    }
    .builder-section {
        margin-top: var(--spacing-large);
        border-top: 1px solid var(--ag-border);
        padding-top: var(--spacing-large);
    }
</style>
