---
import Layout from "../../layouts/Layout.astro";

// Placeholder case studies - these would typically come from content collections
const caseStudies = [
  {
    slug: "fintech-platform",
    title: "Fintech Platform Redesign",
    client: "Series B Fintech Startup",
    category: "Co-Building",
    description: "Transformed a legacy payment platform into a modern, user-centric experience that increased conversion by 40%.",
    tags: ["Product Strategy", "UX Design", "Engineering"],
    featured: true,
    impact: { kgYr: 12500, gbpYr: 4200 },
  },
  {
    slug: "enterprise-dashboard",
    title: "Enterprise Analytics Dashboard",
    client: "Fortune 500 Retailer",
    category: "Consulting",
    description: "Built an internal analytics platform that reduced decision-making time from weeks to hours.",
    tags: ["Data Visualization", "React", "Enterprise"],
    featured: true,
    impact: { kgYr: 8200, gbpYr: 3100 },
  },
  {
    slug: "healthtech-mvp",
    title: "HealthTech MVP Launch",
    client: "Seed-Stage Startup",
    category: "Co-Building",
    description: "Took a healthcare compliance tool from concept to market in 12 weeks with validated product-market fit.",
    tags: ["MVP Development", "Healthcare", "Compliance"],
    featured: false,
    impact: { kgYr: 5600, gbpYr: 1800 },
  },
  {
    slug: "ai-integration",
    title: "AI Integration Strategy",
    client: "Private Equity Portfolio Co.",
    category: "Consulting",
    description: "Developed and implemented an AI strategy that automated 60% of manual processes across three portfolio companies.",
    tags: ["AI/ML", "Strategy", "Automation"],
    featured: false,
    impact: { kgYr: 15200, gbpYr: 5400 },
  },
];
---

<Layout title="Work" description="Case studies and projects from WE3 - see how our senior triads deliver real outcomes.">
  <!-- Coming Soon Banner -->
  <div class="wip-banner" id="wip-banner">
    <div class="wip-backdrop"></div>
    <div class="wip-card">
      <button class="wip-close" id="wip-close" aria-label="Dismiss notice">&times;</button>
      <p class="wip-emoji" aria-hidden="true">🚧</p>
      <h2 class="wip-title">We're loading the truck.</h2>
      <p class="wip-body">
        Our portfolio is being assembled — real work, real outcomes, no stock photos of handshakes.
        Check back soon, or <a href="/brief">start a brief</a> and become the next case study.
      </p>
      <p class="wip-mono mono">v0 &middot; portfolio pending</p>
    </div>
  </div>

  <script>
    // Move banner to document.body so it escapes main's stacking context
    const banner = document.getElementById('wip-banner');
    if (banner) document.body.appendChild(banner);

    document.getElementById('wip-close')?.addEventListener('click', () => {
      const b = document.getElementById('wip-banner');
      if (b) {
        b.style.opacity = '0';
        b.style.pointerEvents = 'none';
        setTimeout(() => b.remove(), 350);
      }
    });
  </script>

  <!-- Page Header -->
  <section class="page-header reveal-up">
    <div class="container container--narrow">
      <p class="eyebrow">Proof of Work</p>
      <h1>Ideas Made Real</h1>
      <p class="page-header__lead">
        We don't just talk—we build. Here are some of the projects where our senior triads
        have delivered real outcomes for real clients.
      </p>
    </div>
  </section>

  <!-- Featured Work -->
  <section class="section">
    <div class="container">
      <div class="section-header">
        <span class="section-header__label">Featured</span>
        <div class="section-header__rule"></div>
      </div>

      <div class="featured-grid fluid-grid">
        {caseStudies.filter(c => c.featured).map((study, i) => (
          <article class={`case-card work-card case-card--featured reveal-up ${i === 0 ? 'case-card--large' : ''} ${i % 3 === 1 ? 'satellite' : ''}`} data-work-card tabindex={0} role="button">
            <div class="case-card__image" aria-hidden="true">
              <div class="case-card__placeholder"></div>
            </div>
            <div class="case-card__content">
              <div class="case-card__meta">
                <span class="badge">{study.category}</span>
                <span class="case-card__client mono">{study.client}</span>
              </div>
              <h3>{study.title}</h3>
              <p>{study.description}</p>
              <div class="case-card__tags">
                {study.tags.map(tag => (
                  <span class="tag">{tag}</span>
                ))}
              </div>
              <span class="case-card__link">View case study &rarr;</span>
            </div>
            <div class="details-pane">
              <h4 class="details-pane__title">Project Impact</h4>
              <div class="data-row">
                <span class="text-data mono" data-value={study.impact.kgYr} data-suffix=" kg/yr">0 kg/yr</span>
              </div>
              <div class="data-row">
                <span class="text-data mono" data-value={study.impact.gbpYr} data-suffix=" £/yr">0 £/yr</span>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- All Work -->
  <section class="section section--alt">
    <div class="container">
      <div class="section-header">
        <span class="section-header__label">More Work</span>
        <div class="section-header__rule"></div>
      </div>

      <div class="work-grid fluid-grid">
        {caseStudies.filter(c => !c.featured).map((study, i) => (
          <article class={`case-card work-card reveal-up ${i % 3 === 1 ? 'satellite' : ''}`} data-work-card tabindex={0} role="button">
            <div class="case-card__content">
              <div class="case-card__meta">
                <span class="badge">{study.category}</span>
                <span class="case-card__client mono">{study.client}</span>
              </div>
              <h3>{study.title}</h3>
              <p>{study.description}</p>
              <div class="case-card__tags">
                {study.tags.map(tag => (
                  <span class="tag">{tag}</span>
                ))}
              </div>
              <span class="case-card__link">View case study &rarr;</span>
            </div>
            <div class="details-pane">
              <h4 class="details-pane__title">Project Impact</h4>
              <div class="data-row">
                <span class="text-data mono" data-value={study.impact.kgYr} data-suffix=" kg/yr">0 kg/yr</span>
              </div>
              <div class="data-row">
                <span class="text-data mono" data-value={study.impact.gbpYr} data-suffix=" £/yr">0 £/yr</span>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Stats / Social Proof -->
  <section class="section">
    <div class="container">
      <div class="stats-grid">
        <div class="stat">
          <span class="stat__number">50+</span>
          <span class="stat__label">Projects Delivered</span>
        </div>
        <div class="stat">
          <span class="stat__number">12</span>
          <span class="stat__label">Ventures Launched</span>
        </div>
        <div class="stat">
          <span class="stat__number">95%</span>
          <span class="stat__label">Client Satisfaction</span>
        </div>
        <div class="stat">
          <span class="stat__number">3</span>
          <span class="stat__label">Successful Exits</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Industries -->
  <section class="section section--alt">
    <div class="container container--narrow">
      <div class="section-header">
        <span class="section-header__label">Industries</span>
        <div class="section-header__rule"></div>
      </div>

      <div class="industries-content">
        <h2>We go where the problems are interesting.</h2>
        <p>
          While we're generalists at heart, we've developed deep expertise in
          certain domains through repeated engagements.
        </p>

        <div class="industries-grid">
          <div class="industry-tag">Fintech</div>
          <div class="industry-tag">Healthcare</div>
          <div class="industry-tag">Enterprise SaaS</div>
          <div class="industry-tag">E-commerce</div>
          <div class="industry-tag">Education</div>
          <div class="industry-tag">Climate Tech</div>
          <div class="industry-tag">B2B Platforms</div>
          <div class="industry-tag">Developer Tools</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Testimonial -->
  <section class="section">
    <div class="container container--narrow">
      <blockquote class="testimonial">
        <p>
          "WE3 doesn't just deliver a strategy deck and walk away. Their team embedded
          with us, built alongside us, and stayed until we had something real. That's
          rare in consulting."
        </p>
        <footer>
          <cite>
            <strong>Sarah Chen</strong>
            <span>CTO, Fintech Startup (Series B)</span>
          </cite>
        </footer>
      </blockquote>
    </div>
  </section>

  <!-- CTA -->
  <section class="section cta-section">
    <div class="container">
      <div class="cta-panel panel text-center">
        <p class="eyebrow">Your project next?</p>
        <h2>Let's build something together.</h2>
        <p class="cta-panel__text">
          Use our Brief Builder to articulate your challenge, and we'll help you figure
          out the best approach.
        </p>
        <div class="cta-panel__actions">
          <a href="/brief" class="btn btn--primary">Start Your Brief</a>
          <a href="/contact" class="btn btn--secondary">Get in Touch</a>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* Page Header */
  .page-header {
    padding: var(--ref-space-xxl) 0 var(--ref-space-xl);
  }

  .page-header h1 {
    margin: var(--ref-space-sm) 0 var(--ref-space-md);
  }

  .page-header__lead {
    font-size: var(--ref-text-md);
    color: var(--sys-color-on-surface-muted);
    line-height: 1.5;
  }

  /* Sections */
  .section {
    padding: clamp(var(--ref-space-xl), 6vw, var(--ref-space-xxl)) 0;
  }

  .section--alt {
    background: var(--sys-surface-alt);
  }

  /* Featured Grid – 2-col only when not using fluid-grid (12-col scatter) */
  .featured-grid:not(.fluid-grid) {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--ref-space-lg);
  }

  .case-card--large {
    grid-row: span 2;
  }

  /* Case Card */
  .case-card {
    background: var(--sys-surface-card);
    border: none;
    border-radius: var(--ref-radius-md);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: transform var(--sys-motion-base);
    cursor: pointer;
  }

  .case-card:hover {
    transform: translateY(-4px);
    box-shadow: none;
  }

  .case-card__image {
    position: relative;
    aspect-ratio: 16 / 9;
    background: var(--sys-surface-alt);
  }

  .case-card--large .case-card__image {
    aspect-ratio: 4 / 3;
  }

  .case-card__placeholder {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(135deg, var(--sys-surface-alt) 25%, transparent 25%),
      linear-gradient(-135deg, var(--sys-surface-alt) 25%, transparent 25%),
      linear-gradient(45deg, var(--sys-surface-alt) 25%, transparent 25%),
      linear-gradient(-45deg, var(--sys-surface-alt) 25%, transparent 25%);
    background-size: 20px 20px;
    background-color: var(--sys-surface-page);
    opacity: 0.5;
  }

  .case-card__content {
    padding: var(--ref-space-lg);
    display: flex;
    flex-direction: column;
    gap: var(--ref-space-sm);
    flex: 1;
  }

  .case-card__meta {
    display: flex;
    align-items: center;
    gap: var(--ref-space-sm);
  }

  .case-card__client {
    font-size: var(--ref-text-xs);
    color: var(--sys-color-on-surface-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .case-card h3 {
    font-size: var(--ref-text-md);
    margin: 0;
  }

  .case-card--large h3 {
    font-size: var(--sys-text-h3);
  }

  .case-card p {
    color: var(--sys-color-on-surface-muted);
    font-size: var(--ref-text-sm);
    line-height: 1.6;
    flex: 1;
  }

  .case-card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .tag {
    font-size: var(--ref-text-xs);
    color: var(--sys-color-on-surface-muted);
    padding: 4px 8px;
    background: var(--sys-surface-alt);
    border-radius: var(--ref-radius-sm);
  }

  .case-card__link {
    font-size: var(--ref-text-sm);
    color: var(--sys-color-accent-subtle);
    margin-top: var(--ref-space-xs);
  }

  /* Work Grid – auto-fit when not using fluid-grid (12-col scatter from global) */
  .work-grid:not(.fluid-grid) {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: var(--ref-space-lg);
  }

  .work-grid .case-card__image {
    display: none;
  }

  /* Stats */
  .stats-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--ref-space-lg);
    text-align: center;
  }

  .stat {
    display: flex;
    flex-direction: column;
    gap: var(--ref-space-xs);
  }

  .stat__number {
    font-family: var(--sys-font-display);
    font-size: var(--ref-text-xl);
    font-weight: 500;
    color: var(--sys-color-accent-subtle);
    line-height: 1;
  }

  .stat__label {
    font-family: var(--sys-font-mono);
    font-size: var(--ref-text-xs);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--sys-color-on-surface-muted);
  }

  /* Industries */
  .industries-content h2 {
    margin-bottom: var(--ref-space-sm);
  }

  .industries-content > p {
    font-size: var(--ref-text-base);
    color: var(--sys-color-on-surface-muted);
    margin-bottom: var(--ref-space-xl);
  }

  .industries-grid {
    display: flex;
    flex-wrap: wrap;
    gap: var(--ref-space-sm);
  }

  .industry-tag {
    padding: 10px 18px;
    background: var(--sys-surface-card);
    border: 1px solid var(--sys-surface-border);
    border-radius: var(--ref-radius-full);
    font-size: var(--ref-text-sm);
  }

  /* Testimonial */
  .testimonial {
    margin: 0;
    padding: var(--ref-space-xl);
    background: var(--sys-surface-card);
    border: none;
    border-radius: var(--ref-radius-lg);
    box-shadow: none;
  }

  .testimonial p {
    font-family: var(--sys-font-display);
    font-size: var(--sys-text-h3);
    font-style: italic;
    line-height: 1.4;
    margin: 0 0 var(--ref-space-lg);
  }

  .testimonial footer {
    display: flex;
    align-items: center;
    gap: var(--ref-space-md);
  }

  .testimonial cite {
    font-style: normal;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .testimonial cite strong {
    font-weight: 500;
  }

  .testimonial cite span {
    font-size: var(--ref-text-sm);
    color: var(--sys-color-on-surface-muted);
  }

  /* CTA Section */
  .cta-section {
    padding-bottom: 0;
  }

  .cta-panel.text-center h2 {
    margin: var(--ref-space-xs) 0 var(--ref-space-md);
  }

  .cta-panel__text {
    color: var(--sys-color-on-surface-muted);
    max-width: 50ch;
    margin: 0 auto var(--ref-space-lg);
  }

  .cta-panel__actions {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: var(--ref-space-sm);
  }

  /* Responsive */
  @media (max-width: 900px) {
    .featured-grid {
      grid-template-columns: 1fr;
    }

    .case-card--large {
      grid-row: auto;
    }

    .stats-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 600px) {
    .stats-grid {
      grid-template-columns: 1fr 1fr;
      gap: var(--ref-space-md);
    }

    .stat__number {
      font-size: var(--ref-text-lg);
    }
  }

</style>

<style is:global>
  /* WIP Banner — mirrors the tools-page modal pattern:
     full-screen velvet-tinted backdrop + centred card in normal surface colour.
     Global because JS moves the banner to document.body. */
  .wip-banner {
    position: fixed;
    inset: 0;
    z-index: 150;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: opacity 0.35s ease;
  }

  /* Full-screen velvet backdrop — same approach as tools .sg-modal__backdrop */
  .wip-backdrop {
    position: fixed;
    inset: 0;
    background: color-mix(in srgb, var(--ref-primitive-velvet) 28%, transparent);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    z-index: 0;
  }

  /* Card — normal surface colour, not purple */
  .wip-card {
    position: relative;
    z-index: 1;
    max-width: 480px;
    width: 100%;
    margin: var(--ref-space-lg);
    padding: var(--ref-space-xl) var(--ref-space-xl) var(--ref-space-lg);
    background: var(--sys-surface-card);
    border: 1px solid var(--sys-surface-border);
    border-radius: var(--ref-radius-lg);
    text-align: center;
    box-shadow: 0 8px 40px rgba(0, 0, 0, 0.1);
  }

  .wip-close {
    position: absolute;
    top: var(--ref-space-sm);
    right: var(--ref-space-sm);
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: transparent;
    border: 1px solid var(--sys-surface-border);
    border-radius: var(--ref-radius-full);
    font-size: 18px;
    color: var(--sys-color-on-surface-muted);
    cursor: pointer;
    transition: color var(--sys-motion-fast), border-color var(--sys-motion-fast), background var(--sys-motion-fast);
  }

  .wip-close:hover {
    color: var(--sys-color-on-surface);
    border-color: var(--sys-color-on-surface);
  }

  .wip-emoji {
    font-size: 2.5rem;
    margin: 0 0 var(--ref-space-sm);
    line-height: 1;
  }

  .wip-title {
    font-size: var(--sys-text-h3);
    margin: 0 0 var(--ref-space-sm);
  }

  .wip-body {
    font-size: var(--ref-text-sm);
    color: var(--sys-color-on-surface-muted);
    line-height: 1.6;
    margin: 0 0 var(--ref-space-md);
  }

  .wip-body a {
    color: var(--sys-color-accent-subtle);
    font-weight: 500;
  }

  .wip-mono {
    font-size: var(--ref-text-xs);
    color: var(--sys-color-on-surface-muted);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin: 0;
  }
</style>
