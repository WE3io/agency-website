---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Privacy Policy" description="How WE3 Ventures Ltd. handles your data and protects your privacy.">
  <!-- Page Header -->
  <section class="page-header reveal-up">
    <div class="container container--narrow">
      <p class="eyebrow">Legal</p>
      <h1>Privacy Policy</h1>
      <p class="page-header__lead">
        This policy explains how WE3 Ventures Ltd. ("WE3", "we", "us") collects,
        uses, and protects information when you visit our website or interact with
        our services.
      </p>
      <p class="mono" style="font-size: var(--ref-text-sm); color: var(--sys-color-on-surface-muted);">
        Effective date: 23 March 2026
      </p>
    </div>
  </section>

  <!-- Who We Are -->
  <section class="section reveal-up">
    <div class="container container--narrow">
      <div class="section-header">
        <span class="section-header__label">Who We Are</span>
        <div class="section-header__rule"></div>
      </div>

      <article class="narrative reveal-up stagger-1">
        <p>
          WE3 Ventures Ltd. is a design and engineering consultancy registered in
          the United Kingdom. Our website is <strong>we3.io</strong> and you can
          reach us at <a href="mailto:hello@we3.io">hello@we3.io</a>.
        </p>
      </article>
    </div>
  </section>

  <!-- Information We Collect -->
  <section class="section section--alt reveal-up">
    <div class="container container--narrow">
      <div class="section-header">
        <span class="section-header__label">Information We Collect</span>
        <div class="section-header__rule"></div>
      </div>

      <article class="narrative reveal-up stagger-1">
        <h2>Information You Provide</h2>
        <p>
          When you fill out our contact form or brief builder, you may provide
          information such as your name, email address, company name, and project
          details. We only collect information that you voluntarily submit to us.
        </p>

        <h2>Information Collected Automatically</h2>
        <p>
          We use privacy-focused analytics (PostHog) to understand how visitors
          use our site. This tracking is <strong>opt-in only</strong>—no data is
          collected until you explicitly consent via our cookie banner. When
          enabled, we may collect:
        </p>
        <ul>
          <li>Pages visited and general navigation patterns</li>
          <li>Referring website or source</li>
          <li>Browser type and device category</li>
          <li>Approximate geographic region (country level)</li>
        </ul>
        <p>
          We do not use session replay, fingerprinting, or any form of cross-site
          tracking. Personally identifiable information (such as names, email
          addresses, or message content) is never sent to our analytics platform.
        </p>
      </article>
    </div>
  </section>

  <!-- How We Use Your Information -->
  <section class="section reveal-up">
    <div class="container container--narrow">
      <div class="section-header">
        <span class="section-header__label">How We Use Your Information</span>
        <div class="section-header__rule"></div>
      </div>

      <article class="narrative reveal-up stagger-1">
        <p>We use the information we collect to:</p>
        <ul>
          <li>Respond to your enquiries and provide the services you request</li>
          <li>Improve our website content and user experience</li>
          <li>Understand aggregate usage patterns to inform product decisions</li>
          <li>Communicate with you about projects or collaborations you've expressed interest in</li>
        </ul>
        <p>
          We will never sell, rent, or share your personal information with third
          parties for their marketing purposes.
        </p>
      </article>
    </div>
  </section>

  <!-- Cookies & Consent -->
  <section class="section section--alt reveal-up">
    <div class="container container--narrow">
      <div class="section-header">
        <span class="section-header__label">Cookies &amp; Consent</span>
        <div class="section-header__rule"></div>
      </div>

      <article class="narrative reveal-up stagger-1">
        <p>
          Our website uses minimal cookies. Analytics cookies are only set
          <strong>after you give explicit consent</strong> through our on-site
          consent banner. You can withdraw consent at any time by clearing your
          browser's local storage or cookies for this site.
        </p>
        <p>
          Essential cookies required for basic site functionality (such as form
          submissions) do not require consent and contain no personal data.
        </p>
      </article>
    </div>
  </section>

  <!-- Data Retention -->
  <section class="section reveal-up">
    <div class="container container--narrow">
      <div class="section-header">
        <span class="section-header__label">Data Retention</span>
        <div class="section-header__rule"></div>
      </div>

      <article class="narrative reveal-up stagger-1">
        <p>
          Analytics data is retained for a maximum of 12 months. Contact form
          submissions are retained only as long as necessary to respond to your
          enquiry and for reasonable business record-keeping purposes.
        </p>
      </article>
    </div>
  </section>

  <!-- Third-Party Services -->
  <section class="section section--alt reveal-up">
    <div class="container container--narrow">
      <div class="section-header">
        <span class="section-header__label">Third-Party Services</span>
        <div class="section-header__rule"></div>
      </div>

      <article class="narrative reveal-up stagger-1">
        <p>We use the following third-party services to operate our website:</p>
        <ul>
          <li><strong>Netlify</strong> — website hosting and form processing</li>
          <li><strong>PostHog</strong> — privacy-focused, opt-in analytics</li>
        </ul>
        <p>
          Each provider processes data in accordance with their own privacy
          policies. We select providers that demonstrate strong data protection
          practices. We may integrate additional third-party communication
          services (such as messaging platforms) to better serve our clients;
          any such integrations will handle data in accordance with this policy.
        </p>
      </article>
    </div>
  </section>

  <!-- Your Rights -->
  <section class="section reveal-up">
    <div class="container container--narrow">
      <div class="section-header">
        <span class="section-header__label">Your Rights</span>
        <div class="section-header__rule"></div>
      </div>

      <article class="narrative reveal-up stagger-1">
        <p>
          Depending on your location, you may have the right to:
        </p>
        <ul>
          <li>Access the personal data we hold about you</li>
          <li>Request correction of inaccurate data</li>
          <li>Request deletion of your data</li>
          <li>Withdraw consent for analytics tracking</li>
          <li>Object to or restrict certain processing of your data</li>
          <li>Request a portable copy of your data</li>
        </ul>
        <p>
          To exercise any of these rights, please contact us at
          <a href="mailto:hello@we3.io">hello@we3.io</a>.
        </p>
      </article>
    </div>
  </section>

  <!-- Children's Privacy -->
  <section class="section section--alt reveal-up">
    <div class="container container--narrow">
      <div class="section-header">
        <span class="section-header__label">Children's Privacy</span>
        <div class="section-header__rule"></div>
      </div>

      <article class="narrative reveal-up stagger-1">
        <p>
          Our services are not directed at individuals under the age of 16. We do
          not knowingly collect personal information from children. If you believe
          we have inadvertently collected such information, please contact us and
          we will promptly delete it.
        </p>
      </article>
    </div>
  </section>

  <!-- Changes to This Policy -->
  <section class="section reveal-up">
    <div class="container container--narrow">
      <div class="section-header">
        <span class="section-header__label">Changes to This Policy</span>
        <div class="section-header__rule"></div>
      </div>

      <article class="narrative reveal-up stagger-1">
        <p>
          We may update this privacy policy from time to time. Any changes will be
          posted on this page with an updated effective date. We encourage you to
          review this page periodically.
        </p>
      </article>
    </div>
  </section>

  <!-- Contact Us -->
  <section class="section section--alt reveal-up">
    <div class="container container--narrow">
      <div class="section-header">
        <span class="section-header__label">Contact Us</span>
        <div class="section-header__rule"></div>
      </div>

      <article class="narrative reveal-up stagger-1">
        <p>
          If you have questions about this privacy policy or how we handle your
          data, please get in touch:
        </p>
        <ul>
          <li>Email: <a href="mailto:hello@we3.io">hello@we3.io</a></li>
          <li>Website: <a href="/contact">we3.io/contact</a></li>
        </ul>
      </article>
    </div>
  </section>
</Layout>
