---
import Layout from "../layouts/Layout.astro";

const quickRefs = [
  {
    title: "Living Style Guide",
    description: "Ground-truth reference for the Curated Collector theme — palette, typography, surfaces, and collection board specimens.",
    href: "/style-guide",
    label: "Open Guide",
    external: false,
  },
];

const tools = [
  {
    number: "01",
    status: "Live",
    statusColor: "sage",
    category: "Project Scoping",
    title: "Brief Builder",
    description:
      "Scope your next project in minutes. Answer six guided questions and receive a tailored engagement recommendation, team shape, cost band, and confidence score — then export as Markdown or JSON.",
    features: [
      "Guided 6-step flow",
      "Engagement type recommendation",
      "Cost band & team shape",
      "Export to Markdown / JSON",
    ],
    cta: { label: "Launch Tool", href: "/brief" },
    external: false,
  },
  {
    number: "02",
    status: "Alpha",
    statusColor: "gold",
    category: "Design Systems",
    title: "00→01 Design Compiler",
    description:
      "A visual design token builder following Material 3 architecture. Create comprehensive design systems with real-time multi-device preview, automatic brand colour extraction, and one-click export to JSON or GitHub.",
    features: [
      "Material 3 token hierarchy",
      "Multi-device preview (desktop → watch)",
      "Brand colour scraping from URL",
      "WCAG contrast checking",
    ],
    cta: { label: "Open Compiler", href: "#" },
    ctaSecondary: { label: "View Source", href: "#" },
    external: true,
  },
  {
    number: "03",
    status: "Live",
    statusColor: "sage",
    category: "Brand Exploration",
    title: "Logo Iterator",
    description:
      "An interactive playground for exploring parametric logo systems. Manipulate geometric shapes, colours, strokes, and glow effects in real-time, then export as SVG or save design states as JSON.",
    features: [
      "Real-time parametric controls",
      "Nonagon geometry engine",
      "SVG export & JSON state management",
      "12 brand token colours",
    ],
    cta: { label: "Open Playground", href: "#", modal: "logo-iterator-modal" },
    ctaSecondary: { label: "View Source", href: "#" },
    external: false,
  },
];
---

<Layout title="Tools" description="Open-source tools, experiments, and resources from the WE3 workshop. Built for builders — free to explore, use, and contribute to.">
  <!-- Atmospheric backdrop — concept exploration -->
  <div class="tools-backdrop" aria-hidden="true"></div>

  <!-- Page Header -->
  <section class="tools">
    <div class="container tools__content">
      <header class="tools__header">
        <p class="eyebrow mono">Open Collection</p>
        <h1>The Workshop</h1>
        <p class="tools__lead">
          Open-source tools, experiments, and resources from our workshop.
          Built for builders — free to explore, use, and contribute to.
        </p>
      </header>

      <!-- Tool Cards -->
      <div class="tools__grid">
        {tools.map((tool) => (
          <article class="tool-card">
            <div class="tool-card__badge">
              <span class="mono">{tool.number}</span>
            </div>
            <div class="tool-card__content">
              <div class="tool-card__meta">
                <span class={`tool-card__status tool-card__status--${tool.statusColor}`}>
                  {tool.status}
                </span>
                <span class="tool-card__category">{tool.category}</span>
              </div>
              <h2 class="tool-card__title">{tool.title}</h2>
              <p class="tool-card__description">{tool.description}</p>
              <ul class="tool-card__features">
                {tool.features.map((feature) => (
                  <li>{feature}</li>
                ))}
              </ul>
              <div class="tool-card__actions">
                <a
                  href={tool.cta.href}
                  class="btn btn--primary"
                  {...(tool.external ? { target: "_blank", rel: "noopener noreferrer" } : {})}
                  {...(tool.cta.modal ? { "data-modal": tool.cta.modal } : {})}
                >
                  {tool.cta.label}
                </a>
                {tool.ctaSecondary && (
                  <a
                    href={tool.ctaSecondary.href}
                    class="btn btn--secondary"
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    {tool.ctaSecondary.label}
                  </a>
                )}
              </div>
            </div>
          </article>
        ))}
      </div>

      <!-- Quick References -->
      <div class="tools__refs">
        <div class="section-header">
          <span class="section-header__label">Quick References</span>
          <div class="section-header__rule"></div>
        </div>
        <div class="refs__grid">
          {quickRefs.map((ref) => (
            <a
              href={ref.href}
              class="ref-card"
              data-modal="style-guide-modal"
              {...(ref.external ? { target: "_blank", rel: "noopener noreferrer" } : {})}
            >
              <div class="ref-card__thumb">
                <div class="ref-card__swatches">
                  <span style="background: var(--ref-neutral-vanilla)"></span>
                  <span style="background: var(--ref-primitive-surf)"></span>
                  <span style="background: var(--ref-primitive-harvest)"></span>
                  <span style="background: var(--ref-primitive-rocket)"></span>
                  <span style="background: var(--ref-primitive-velvet)"></span>
                </div>
                <span class="ref-card__thumb-label mono">Aa</span>
              </div>
              <div class="ref-card__content">
                <h3 class="ref-card__title">{ref.title}</h3>
                <p class="ref-card__description">{ref.description}</p>
              </div>
              <span class="ref-card__arrow">&rarr;</span>
            </a>
          ))}
        </div>
      </div>

      <!-- Community CTA -->
      <div class="tools__cta cta-panel panel text-center">
        <p class="eyebrow mono">Get Involved</p>
        <h2>Built by the community, for the community</h2>
        <p class="cta-panel__text">
          Have feedback, a contribution, or a tool idea? We'd love to hear it.
        </p>
        <a href="/contact" class="btn btn--primary">Get in Touch</a>
      </div>
    </div>
  </section>

  <!-- Style Guide Modal -->
  <div class="sg-modal" id="style-guide-modal" aria-hidden="true">
    <div class="sg-modal__backdrop"></div>
    <div class="sg-modal__container">
      <div class="sg-modal__header">
        <span class="sg-modal__title mono">Living Style Guide</span>
        <button class="sg-modal__close" aria-label="Close style guide">&times;</button>
      </div>
      <iframe class="sg-modal__iframe" title="WE3 Style Guide"></iframe>
    </div>
  </div>

  <!-- Logo Iterator Modal -->
  <div class="sg-modal" id="logo-iterator-modal" aria-hidden="true">
    <div class="sg-modal__backdrop"></div>
    <div class="sg-modal__container">
      <div class="sg-modal__header">
        <span class="sg-modal__title mono">Logo Iterator</span>
        <button class="sg-modal__close" aria-label="Close logo iterator">&times;</button>
      </div>
      <iframe class="sg-modal__iframe" title="WE3 Logo Iterator"></iframe>
    </div>
  </div>
</Layout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const modalConfigs = [
      { id: 'style-guide-modal', src: '/style-guide' },
      { id: 'logo-iterator-modal', src: '/logo-iterator' },
    ];

    modalConfigs.forEach(({ id, src }) => {
      const modal = document.getElementById(id);
      if (!modal) return;

      const backdrop = modal.querySelector('.sg-modal__backdrop');
      const closeBtn = modal.querySelector('.sg-modal__close');
      const iframe = modal.querySelector('.sg-modal__iframe');

      function openModal() {
        if (iframe instanceof HTMLIFrameElement) {
          iframe.src = src;
        }
        modal.setAttribute('aria-hidden', 'false');
        document.body.style.overflow = 'hidden';
      }

      function closeModal() {
        modal.setAttribute('aria-hidden', 'true');
        document.body.style.overflow = '';
        if (iframe instanceof HTMLIFrameElement) {
          iframe.src = '';
        }
      }

      // Open modal from any element with data-modal matching this modal's id
      document.querySelectorAll(`[data-modal="${id}"]`).forEach((link) => {
        link.addEventListener('click', (e) => {
          e.preventDefault();
          openModal();
        });
      });

      closeBtn?.addEventListener('click', closeModal);
      backdrop?.addEventListener('click', closeModal);

      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && modal.getAttribute('aria-hidden') === 'false') {
          closeModal();
        }
      });
    });
  });
</script>

<style>
  /* ==========================================================================
     Atmospheric Backdrop — Curated Collector concept exploration
     Two radial glows (sage + gold) fixed behind content, matching the
     design-exploration/curated-collector prototype.
     ========================================================================== */

  .tools-backdrop {
    position: fixed;
    inset: 0;
    background:
      radial-gradient(600px circle at 15% 10%, var(--glow-warm), transparent 70%),
      radial-gradient(520px circle at 90% 0%, var(--glow-gold), transparent 60%);
    opacity: 0.8;
    z-index: 0;
    pointer-events: none;
  }

  /* Paper texture overlay on cards — subtle repeating-gradient grain */
  .tool-card::before,
  .ref-card::before,
  .tools__cta::before {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: repeating-linear-gradient(
      120deg,
      rgba(0, 0, 0, 0.03) 0,
      rgba(0, 0, 0, 0.03) 1px,
      transparent 1px,
      transparent 10px
    );
    opacity: 0.5;
    pointer-events: none;
  }

  /* Tools Page */
  .tools {
    position: relative;
    z-index: 1;
    padding: var(--ref-space-xxl) 0 clamp(var(--ref-space-xl), 6vw, var(--ref-space-xxl));
  }

  .tools__content {
    display: flex;
    flex-direction: column;
    gap: clamp(var(--ref-space-xl), 6vw, var(--ref-space-xxl));
  }

  /* Header */
  .tools__header {
    max-width: 700px;
  }

  .tools__header h1 {
    margin: var(--ref-space-sm) 0 var(--ref-space-md);
  }

  .tools__lead {
    font-size: var(--ref-text-md);
    color: var(--sys-color-on-surface-muted);
    line-height: 1.5;
  }

  /* Grid */
  .tools__grid {
    display: flex;
    flex-direction: column;
    gap: var(--ref-space-lg);
  }

  /* Tool Card */
  .tool-card {
    position: relative;
    overflow: hidden;
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--ref-space-xl);
    background: var(--sys-surface-card);
    border: none;
    border-radius: var(--ref-radius-lg);
    padding: var(--ref-space-xl);
    box-shadow: none;
    transition: transform var(--sys-motion-base);
  }

  .tool-card:hover {
    transform: translateY(-3px);
    box-shadow: none;
  }

  /* Badge */
  .tool-card__badge {
    font-size: var(--ref-text-xl);
    color: var(--sys-color-accent-brand);
    opacity: 0.35;
    font-weight: 300;
    line-height: 1;
    user-select: none;
  }

  /* Content */
  .tool-card__content {
    display: flex;
    flex-direction: column;
    gap: var(--ref-space-sm);
  }

  .tool-card__meta {
    display: flex;
    align-items: center;
    gap: var(--ref-space-sm);
  }

  .tool-card__status {
    display: inline-flex;
    align-items: center;
    padding: 4px 10px;
    border-radius: var(--ref-radius-full);
    font-family: var(--sys-font-mono);
    font-size: var(--ref-text-xs);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-weight: 500;
  }

  .tool-card__status--sage {
    background: color-mix(in srgb, var(--ref-primitive-surf), transparent 88%);
    color: var(--sys-color-accent-subtle);
  }

  .tool-card__status--gold {
    background: color-mix(in srgb, var(--ref-primitive-harvest), transparent 82%);
    color: color-mix(in srgb, var(--ref-primitive-harvest), var(--ref-neutral-ink) 50%);
  }

  .tool-card__status--navy {
    background: color-mix(in srgb, var(--ref-primitive-velvet), transparent 88%);
    color: var(--sys-color-highlight);
  }

  .tool-card__category {
    font-family: var(--sys-font-mono);
    font-size: var(--ref-text-xs);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--sys-color-on-surface-muted);
  }

  .tool-card__title {
    font-size: var(--ref-text-lg);
    margin-bottom: var(--ref-space-xs);
  }

  .tool-card__description {
    font-size: var(--ref-text-base);
    color: var(--sys-color-on-surface-muted);
    line-height: 1.6;
    max-width: 60ch;
  }

  .tool-card__features {
    list-style: none;
    padding: 0;
    margin: var(--ref-space-sm) 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--ref-space-xs) var(--ref-space-lg);
  }

  .tool-card__features li {
    font-size: var(--ref-text-sm);
    color: var(--sys-color-on-surface-muted);
    padding-left: var(--ref-space-md);
    position: relative;
  }

  .tool-card__features li::before {
    content: "•";
    position: absolute;
    left: 0;
    color: var(--sys-color-accent-subtle);
  }

  .tool-card__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--ref-space-sm);
    margin-top: var(--ref-space-md);
  }

  /* Quick References */
  .refs__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: var(--ref-space-md);
  }

  .ref-card {
    position: relative;
    overflow: hidden;
    display: flex;
    align-items: center;
    gap: var(--ref-space-md);
    padding: var(--ref-space-lg);
    background: var(--sys-surface-card);
    border: none;
    border-radius: var(--ref-radius-md);
    text-decoration: none;
    color: inherit;
    transition: transform var(--sys-motion-base), border-color var(--sys-motion-base);
  }

  .ref-card:hover {
    transform: translateY(-2px);
    box-shadow: none;
    border-color: var(--sys-color-accent-subtle);
    text-decoration: none;
  }

  .ref-card__content {
    flex: 1;
  }

  .ref-card__title {
    font-size: var(--ref-text-base);
    margin-bottom: var(--ref-space-xs);
  }

  .ref-card__description {
    font-size: var(--ref-text-sm);
    color: var(--sys-color-on-surface-muted);
    line-height: 1.5;
  }

  .ref-card__arrow {
    font-size: var(--ref-text-md);
    color: var(--sys-color-accent-subtle);
    flex-shrink: 0;
    transition: transform var(--sys-motion-fast);
  }

  .ref-card:hover .ref-card__arrow {
    transform: translateX(4px);
  }

  /* CTA Panel */
  .tools__cta h2 {
    margin: var(--ref-space-xs) 0 var(--ref-space-md);
  }

  .tools__cta .cta-panel__text {
    color: var(--sys-color-on-surface-muted);
    max-width: 50ch;
    margin: 0 auto var(--ref-space-lg);
  }

  /* Ref-card Thumbnail */
  .ref-card__thumb {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 6px;
    width: 80px;
    min-height: 64px;
    background: var(--sys-surface-alt);
    border-radius: var(--ref-radius-sm);
    flex-shrink: 0;
  }

  .ref-card__swatches {
    display: flex;
    gap: 4px;
  }

  .ref-card__swatches span {
    display: block;
    width: 10px;
    height: 10px;
    border-radius: 50%;
  }

  .ref-card__thumb-label {
    font-size: 11px;
    color: var(--sys-color-on-surface-muted);
    letter-spacing: 0.04em;
  }

  /* Style Guide Modal */
  .sg-modal {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 200;
    align-items: center;
    justify-content: center;
  }

  .sg-modal[aria-hidden="false"] {
    display: flex;
  }

  .sg-modal__backdrop {
    position: fixed;
    inset: 0;
    background: color-mix(in srgb, var(--ref-neutral-ink), transparent 72%);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    z-index: 0;
  }

  .sg-modal__container {
    position: fixed;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    display: flex;
    flex-direction: column;
    width: 92vw;
    height: 90vh;
    max-width: 1400px;
    background: var(--sys-surface-card);
    border-radius: var(--ref-radius-lg);
    overflow: hidden;
    box-shadow: none;
    z-index: 1;
  }

  .sg-modal__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--ref-space-md) var(--ref-space-xl);
    border-bottom: 1px solid var(--sys-surface-border);
    background: var(--sys-surface-alt);
    flex-shrink: 0;
  }

  .sg-modal__title {
    font-size: var(--ref-text-sm);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--sys-color-on-surface-muted);
  }

  .sg-modal__close {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border: none;
    background: none;
    font-size: 24px;
    line-height: 1;
    color: var(--sys-color-on-surface-muted);
    cursor: pointer;
    border-radius: var(--ref-radius-sm);
    transition: color var(--sys-motion-fast), background var(--sys-motion-fast);
  }

  .sg-modal__close:hover {
    color: var(--sys-color-accent-subtle);
    background: color-mix(in srgb, var(--ref-neutral-ink), transparent 95%);
  }

  .sg-modal__iframe {
    flex: 1;
    width: 100%;
    border: none;
  }

  /* Responsive */
  @media (max-width: 768px) {
    .tool-card {
      grid-template-columns: 1fr;
      gap: var(--ref-space-md);
      padding: var(--ref-space-lg);
    }

    .tool-card__badge {
      font-size: var(--ref-text-lg);
    }

    .tool-card__features {
      flex-direction: column;
      gap: var(--ref-space-xs);
    }

    .tool-card__actions {
      flex-direction: column;
    }

    .tool-card__actions .btn {
      width: 100%;
    }

    .sg-modal__container {
      width: 100vw;
      height: 100vh;
      max-width: none;
      border-radius: 0;
    }

    .ref-card__thumb {
      width: 60px;
      min-height: 52px;
    }

    .ref-card__swatches span {
      width: 8px;
      height: 8px;
    }
  }
</style>
