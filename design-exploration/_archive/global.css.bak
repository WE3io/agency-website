/* ==========================================================================
   WE3 Claude Variant — Token-Backed Design System
   Source of truth: tokens/tokens.draft.json (reference → system → component)
   ========================================================================== */

:root {
  /* ---------- Reference: Palette — Neutrals ---------- */
  --ref-neutral-linen: color-mix(in srgb, #F4EAD0, #FFFFFF 60%);
  --ref-neutral-bone: color-mix(in srgb, #F4EAD0, #FFFFFF 30%);
  --ref-neutral-vanilla: #F4EAD0;
  --ref-neutral-studio-clay: color-mix(in srgb, #F4EAD0, #E2C397 50%);
  --ref-neutral-cork: #E2C397;
  --ref-neutral-ink: #29004B;

  /* ---------- Reference: Palette — Primitives ---------- */
  --ref-primitive-surf: #5BA79C;
  --ref-primitive-harvest: #FEBE27;
  --ref-primitive-sunset: #FF6B33;
  --ref-primitive-rocket: #EF2337;
  --ref-primitive-punch: #D02365;
  --ref-primitive-velvet: #720A63;

  /* ---------- Reference: Spacing ---------- */
  --ref-space-xs: 9px;
  --ref-space-sm: 15px;
  --ref-space-md: 24px;
  --ref-space-lg: 30px;
  --ref-space-xl: 48px;
  --ref-space-xxl: 66px;

  /* ---------- Reference: Radius ---------- */
  --ref-radius-sm: 15px;
  --ref-radius-md: 30px;
  --ref-radius-lg: 60px;
  --ref-radius-full: 999px;

  /* ---------- Reference: Typography ---------- */
  --ref-font-display: 'League Gothic', sans-serif;
  --ref-font-body: 'Inter', sans-serif;
  --ref-font-mono: 'IBM Plex Mono', monospace;
  --ref-text-xs: 12px;
  --ref-text-sm: 15px;
  --ref-text-base: 18px;
  --ref-text-md: 24px;
  --ref-text-lg: 48px;
  --ref-text-xl: 72px;
  --ref-text-xxl: 110px;
  --ref-weight-regular: 400;
  --ref-weight-medium: 500;
  --ref-weight-semibold: 600;
  --ref-weight-bold: 700;
  --ref-leading-tight: 0.9;
  --ref-leading-normal: 1.2;
  --ref-leading-loose: 1.6;

  /* ---------- Reference: Motion ---------- */
  --ref-motion-fast: 150ms ease;
  --ref-motion-base: 220ms ease;
  --ref-motion-slow: 350ms ease;

  /* ---------- Reference: Grid ---------- */
  --ref-grid-container: 1440px;
  --ref-grid-columns: 12;
  --ref-grid-gutter: 24px;
  --ref-grid-padding: 48px;

  /* ==========================================================================
     System Layer — Semantic mappings
     ========================================================================== */

  /* ---------- System: Color ---------- */
  --sys-color-primary: var(--ref-neutral-ink);
  --sys-color-secondary: var(--ref-neutral-cork);
  --sys-color-on-surface: var(--ref-neutral-ink);
  --sys-color-on-surface-muted: color-mix(in srgb, var(--ref-neutral-ink), var(--ref-neutral-vanilla) 55%);
  --sys-color-on-action: var(--ref-neutral-linen);
  --sys-color-action-primary: var(--ref-primitive-rocket);
  --sys-color-action-secondary: var(--ref-primitive-sunset);
  --sys-color-action-tertiary: var(--ref-primitive-harvest);
  --sys-color-action-hover: var(--ref-primitive-punch);
  --sys-color-accent-subtle: var(--ref-primitive-surf);
  --sys-color-accent-brand: var(--ref-primitive-harvest);
  --sys-color-highlight: var(--ref-primitive-velvet);
  --sys-color-error: #EF4444;
  --sys-color-success: #22C55E;

  /* ---------- System: Surface ---------- */
  --sys-surface-page: var(--ref-neutral-linen);
  --sys-surface-card: var(--ref-neutral-bone);
  --sys-surface-alt: var(--ref-neutral-vanilla);
  --sys-surface-hover: var(--ref-neutral-studio-clay);
  --sys-surface-border: var(--ref-neutral-cork);

  /* ---------- System: Typography ---------- */
  --sys-font-family: var(--ref-font-body);
  --sys-font-display: var(--ref-font-display);
  --sys-font-mono: var(--ref-font-mono);
  --sys-line-height: var(--ref-leading-loose);
  --sys-letter-spacing: 0.01em;
  --sys-text-h1: var(--ref-text-xl);
  --sys-text-h2: var(--ref-text-lg);
  --sys-text-h3: 36px; /* Derived: ref-text-md × 1.5 */
  --sys-text-h4: var(--ref-text-md);

  /* ---------- System: Spacing ---------- */
  --sys-spacing-unit: var(--ref-space-md);
  --sys-gutter: var(--ref-grid-gutter);
  --sys-page-padding: var(--ref-grid-padding);
  --sys-card-padding: var(--ref-space-md);
  --sys-section-padding: var(--ref-space-xxl);

  /* ---------- System: Motion ---------- */
  --sys-motion-fast: var(--ref-motion-fast);
  --sys-motion-base: var(--ref-motion-base);
  --sys-motion-slow: var(--ref-motion-slow);

  /* ==========================================================================
     Component Layer — Element-specific tokens
     ========================================================================== */

  /* ---------- Component: Button ---------- */
  --comp-button-height: 44px;
  --comp-button-padding: var(--ref-space-md);
  --comp-button-radius: var(--ref-radius-full);
  --comp-button-font-size: var(--ref-text-sm);
  --comp-button-primary-bg: var(--sys-color-action-primary);
  --comp-button-secondary-bg: transparent;
  --comp-button-secondary-border: var(--sys-surface-border);
  --comp-button-ghost-bg: transparent;

  /* ---------- Component: Card ---------- */
  --comp-card-bg: var(--sys-surface-card);
  --comp-card-border: none;
  --comp-card-radius: var(--ref-radius-md);
  --comp-card-padding: var(--ref-space-lg);

  /* ---------- Component: Panel ---------- */
  --comp-panel-bg: var(--sys-surface-card);
  --comp-panel-border: none;
  --comp-panel-radius: var(--ref-radius-lg);
  --comp-panel-padding: var(--ref-space-xl);

  /* ---------- Component: Input ---------- */
  --comp-input-height: 44px;
  --comp-input-padding: var(--ref-space-sm);
  --comp-input-radius: var(--ref-radius-sm);
  --comp-input-border: var(--sys-surface-border);
  --comp-input-focus: var(--sys-color-highlight);

  /* ---------- Component: Badge ---------- */
  --comp-badge-bg: var(--sys-surface-alt);
  --comp-badge-border: var(--sys-surface-border);
  --comp-badge-radius: var(--ref-radius-full);
  --comp-badge-font-size: var(--ref-text-xs);

  /* ---------- Component: Stripe ---------- */
  --s1: var(--ref-primitive-harvest);
  --s2: var(--ref-primitive-sunset);
  --s3: var(--ref-primitive-rocket);
  --s4: var(--ref-primitive-punch);
  --s5: var(--ref-primitive-velvet);
  --stripe-stacked: linear-gradient(to bottom,
      var(--s1) 0%, var(--s1) 20%,
      var(--s2) 20%, var(--s2) 40%,
      var(--s3) 40%, var(--s3) 60%,
      var(--s4) 60%, var(--s4) 80%,
      var(--s5) 80%, var(--s5) 100%);
  --stripe: repeating-linear-gradient(90deg,
      var(--s1) 0 12px, var(--s2) 12px 20px,
      var(--s3) 20px 28px, var(--s4) 28px 36px, var(--s5) 36px 44px);

  /* ---------- Component: Cursor ---------- */
  --comp-cursor-color: var(--sys-color-highlight);
  --comp-cursor-size: 12px;

  /* ---------- Component: Icon ---------- */
  --comp-icon-stroke: 1.5;
  --comp-icon-default: var(--sys-color-on-surface);
  --comp-icon-accent-surf: var(--sys-color-accent-subtle);
  --comp-icon-accent-brand: var(--sys-color-accent-brand);
  --comp-icon-interactive: var(--sys-color-highlight);
  --comp-icon-on-action: var(--sys-color-on-action);
  --comp-icon-on-dark: var(--ref-neutral-bone);

  /* ---------- Atmospheric / Glows ---------- */
  --glow-warm: rgba(114, 10, 99, 0.18); /* Velvet-derived */
  --glow-gold: rgba(254, 190, 39, 0.12); /* Harvest-derived */

  /* ---------- Shadows (flat for now) ---------- */
  --shadow-sm: none;
  --shadow-md: none;
  --shadow-lg: none;
  --shadow-card: none;
  --effect-shadow-panel: none;
  --effect-shadow-image: none;

}

/* ==========================================================================
   Reset & Base
   ========================================================================== */

*,
*::before,
*::after {
  box-sizing: border-box;
}

body {
  margin: 0;
  min-height: 100vh;
  background: var(--sys-surface-page);
  color: var(--sys-color-on-surface);
  font-family: var(--sys-font-family);
  font-size: var(--ref-text-base);
  line-height: var(--sys-line-height);
  letter-spacing: var(--sys-letter-spacing);
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

/* ==========================================================================
   Claude variant — fonts and base overrides already set via token layer
   ========================================================================== */

body.variant-claude {
  background-color: var(--sys-surface-page);
  color: var(--sys-color-on-surface);
  font-family: var(--sys-font-family);
  -webkit-font-smoothing: antialiased;
}

/* Prevent content overlay: main and sections stack in document order, no overlapping */
body.variant-claude main#main-content {
  position: relative;
  z-index: 1;
}

body.variant-claude main#main-content>* {
  position: relative;
}

/* League Gothic – headlines and all numbers */
body.variant-claude h1,
body.variant-claude h2,
body.variant-claude h3,
body.variant-claude h4,
body.variant-claude .text-data,
body.variant-claude .stat__number,
body.variant-claude .engagement-card__number,
body.variant-claude .benefit__number,
body.variant-claude .cost-card__duration,
body.variant-claude .engagement-number .mono {
  font-family: var(--sys-font-display);
  text-transform: uppercase;
  letter-spacing: 0.02em;
  font-weight: var(--ref-weight-regular);
  line-height: var(--ref-leading-tight);
}

body.variant-claude h1 {
  font-size: clamp(3rem, 9vw, var(--sys-text-h1));
}

body.variant-claude h2 {
  font-size: var(--sys-text-h2);
}

body.variant-claude h3 {
  font-size: var(--sys-text-h3);
}

body.variant-claude h4 {
  font-size: var(--sys-text-h4);
}

/* Technical label style */
body.variant-claude .section-header__label,
body.variant-claude .eyebrow,
body.variant-claude .card-label,
body.variant-claude .technical-note {
  font-family: var(--sys-font-family);
  font-weight: var(--ref-weight-bold);
  font-size: var(--ref-text-xs);
  text-transform: none;
  letter-spacing: -0.01em;
  display: block;
}

/* ==========================================================================
   Typography
   ========================================================================== */

h1,
h2,
h3,
h4 {
  font-family: var(--sys-font-display);
  font-weight: var(--ref-weight-medium);
  line-height: var(--ref-leading-normal);
  margin: 0;
}

h1 {
  font-size: var(--sys-text-h1);
}

h2 {
  font-size: var(--sys-text-h2);
}

h3 {
  font-size: var(--sys-text-h3);
}

h4 {
  font-size: var(--sys-text-h4);
}

p {
  margin: 0;
}

a {
  color: var(--sys-color-on-surface);
  text-decoration: none;
  transition: color var(--sys-motion-fast);
}

a:hover {
  text-decoration: underline;
  text-underline-offset: 4px;
}

/* Eyebrow / Kicker text */
.eyebrow {
  font-family: var(--sys-font-mono);
  font-size: var(--ref-text-xs);
  font-weight: var(--ref-weight-regular);
  text-transform: uppercase;
  letter-spacing: 0.2em;
  color: var(--sys-color-on-surface-muted);
}

.mono {
  font-family: var(--sys-font-mono);
}

/* Display font for number elements */
.engagement-card__number,
.benefit__number,
.cost-card__duration,
.engagement-number .mono {
  font-family: var(--sys-font-display);
  font-optical-sizing: auto;
  font-weight: var(--ref-weight-regular);
  font-style: normal;
  font-variation-settings: "wdth" 100;
}

/* ==========================================================================
   Layout
   ========================================================================== */

.container {
  width: 100%;
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 var(--ref-space-lg);
}

.container--narrow {
  max-width: 800px;
}

.container--wide {
  max-width: 1400px;
}

/* ==========================================================================
   Panels & Cards - Objects in a Collection
   ========================================================================== */

.panel {
  background: var(--comp-panel-bg);
  border: var(--comp-panel-border);
  border-radius: var(--comp-panel-radius);
  padding: clamp(var(--ref-space-lg), 4vw, var(--comp-panel-padding));
  box-shadow: var(--shadow-card);
  position: relative;
}

.card {
  background: var(--comp-card-bg);
  border: 1px solid transparent;
  border-radius: var(--comp-card-radius);
  padding: var(--comp-card-padding);
  box-shadow: var(--shadow-card);
  transition: transform var(--sys-motion-base), border-color var(--sys-motion-base), box-shadow var(--sys-motion-base);
}

.card:hover {
  transform: translateY(-2px);
  border-color: var(--sys-color-highlight);
  box-shadow: var(--shadow-card);
}

/* Card with slight rotation - collection feel */
.card--tilted {
  transform: rotate(var(--tilt, -1deg));
}

.card--tilted:hover {
  transform: rotate(0deg) translateY(-2px);
}

/* ==========================================================================
   Buttons
   ========================================================================== */

.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: var(--ref-space-xs);
  padding: var(--ref-space-sm) var(--comp-button-padding);
  border-radius: var(--comp-button-radius);
  border: 1px solid transparent;
  font-family: var(--sys-font-family);
  font-size: var(--comp-button-font-size);
  font-weight: var(--ref-weight-medium);
  cursor: pointer;
  transition: all var(--sys-motion-base);
  text-decoration: none;
}

.btn:hover {
  text-decoration: none;
}

.btn--primary {
  background: var(--comp-button-primary-bg);
  color: var(--sys-color-on-action);
  box-shadow: var(--shadow-sm);
}

.btn--primary:hover {
  transform: translateY(-1px);
  box-shadow: var(--shadow-sm);
}

.btn--secondary {
  background: var(--comp-button-secondary-bg);
  border-color: var(--comp-button-secondary-border);
  color: var(--sys-color-on-surface);
}

.btn--secondary:hover {
  border-color: var(--sys-color-action-primary);
  color: var(--sys-color-action-primary);
}

.btn--ghost {
  background: var(--comp-button-ghost-bg);
  color: var(--sys-color-on-surface);
  padding: var(--ref-space-xs) var(--ref-space-sm);
}

.btn--ghost:hover {
  color: var(--sys-color-accent-subtle);
}

/* ==========================================================================
   Form Elements
   ========================================================================== */

.field {
  display: flex;
  flex-direction: column;
  gap: var(--ref-space-xs);
}

.field label {
  font-size: var(--ref-text-sm);
  color: var(--sys-color-on-surface-muted);
}

.field input,
.field textarea,
.field select {
  width: 100%;
  padding: var(--comp-input-padding) var(--ref-space-sm);
  border: 1px solid var(--comp-input-border);
  border-radius: var(--comp-input-radius);
  background: var(--sys-surface-card);
  color: var(--sys-color-on-surface);
  font-family: var(--sys-font-family);
  font-size: var(--ref-text-base);
  transition: border-color var(--sys-motion-fast), box-shadow var(--sys-motion-fast);
}

.field input:focus,
.field textarea:focus,
.field select:focus {
  outline: none;
  border-color: var(--comp-input-focus);
  box-shadow: none;
}

.field textarea {
  min-height: 120px;
  resize: vertical;
}

/* ==========================================================================
   Decorative Elements
   ========================================================================== */

.stripe {
  height: 8px;
  background: var(--stripe);
  border-radius: var(--ref-radius-full);
}

.stripe--thin {
  height: 4px;
}

/* Masthead and footer stripes: 5 stacked action colors, 80px, flush (no radius) */
body.variant-claude .site-header .stripe--masthead,
body.variant-claude .site-footer .stripe--footer {
  height: 80px !important;
  background: var(--stripe-stacked) !important;
  border-radius: 0 !important;
}

/* ==========================================================================
   Organic Momentum – Liquid Pour strip, typewriter, spring reveal, scatter grid
   ========================================================================== */

/* 1. Top strip below nav: left-to-right then ease down on page load (nav visible first, then strip) */
body.variant-claude .site-header .stripe--masthead.momentum-entry {
  height: 4px !important;
  transform-origin: left center;
  animation: momentum-strip-draw 1.2s cubic-bezier(0.85, 0, 0.15, 1) 0.2s forwards;
  /* 0.2s delay so nav loads first */
}

@keyframes momentum-strip-draw {
  0% {
    transform: scaleX(0);
    height: 4px;
  }

  35% {
    transform: scaleX(1);
    height: 4px;
  }

  /* Ease down: strip grows to full height */
  100% {
    transform: scaleX(1);
    height: 80px;
  }
}

/* 2. Typewriter Reveal – labels inside .reveal-up start hidden, then type in when .active (Inter for Claude) */
body.variant-claude .reveal-up .section-header__label,
body.variant-claude .reveal-up .eyebrow,
body.variant-claude .reveal-up .card-label,
body.variant-claude .reveal-up.section-header__label,
body.variant-claude .reveal-up.eyebrow,
body.variant-claude .reveal-up.card-label {
  font-family: var(--sys-font-family);
  display: inline-block;
  overflow: hidden;
  white-space: nowrap;
  width: 0;
  opacity: 0;
}

.reveal-up.active .section-header__label,
.reveal-up.active .eyebrow,
.reveal-up.active .card-label,
/* When the label/eyebrow is itself the reveal-up (e.g. hero) */
.reveal-up.active.section-header__label,
.reveal-up.active.eyebrow,
.reveal-up.active.card-label {
  opacity: 1;
  animation: typing 1s steps(40, end) forwards;
  animation-delay: 0.4s;
  /* Waits for the card/section to settle */
}

@keyframes typing {
  from {
    width: 0;
  }

  to {
    width: 100%;
  }
}

/* 3. Organic Momentum Reveal – Spring Physics (weight, slight bounce) */
.reveal-up {
  opacity: 0;
  transform: translateY(80px) rotate(1.5deg) scale(0.96);
  transition:
    opacity 1.2s ease-out,
    transform 1.4s cubic-bezier(0.23, 1.25, 0.46, 1);
  /* Spring Easing */
}

.reveal-up.active {
  opacity: 1;
  transform: translateY(0) rotate(0deg) scale(1);
}

/* Stagger children (e.g. hero H1 lines) */
.reveal-up.stagger-1 {
  transition-delay: 0.1s;
}

.reveal-up.stagger-2 {
  transition-delay: 0.25s;
}

.reveal-up.stagger-3 {
  transition-delay: 0.4s;
}

.reveal-up.stagger-4 {
  transition-delay: 0.55s;
}

.reveal-up.stagger-5 {
  transition-delay: 0.7s;
}

.reveal-up.stagger-1.active .section-header__label,
.reveal-up.stagger-1.active .eyebrow {
  animation-delay: 0.5s;
}

.reveal-up.stagger-2.active .section-header__label,
.reveal-up.stagger-2.active .eyebrow {
  animation-delay: 0.65s;
}

.reveal-up.stagger-3.active .section-header__label,
.reveal-up.stagger-3.active .eyebrow {
  animation-delay: 0.8s;
}

.reveal-up.stagger-4.active .section-header__label,
.reveal-up.stagger-4.active .eyebrow {
  animation-delay: 0.95s;
}

.reveal-up.stagger-5.active .section-header__label,
.reveal-up.stagger-5.active .eyebrow {
  animation-delay: 1.1s;
}

/* 4. 12-Column Scatter Grid – asymmetrical, repeating 3-card pattern (MetaLab-style) */
.fluid-grid {
  display: grid;
  grid-template-columns: repeat(12, 1fr);
  gap: 8vw 4vw;
  align-items: start;
}

/* Card Type A: The "Anchor" (left-aligned, wide) */
.fluid-grid .case-card:nth-child(3n+1) {
  grid-column: 1 / span 8;
  margin-top: 0;
}

/* Card Type B: The "Satellite" (right-aligned, floating; 15vh + parallax in script) */
.fluid-grid .case-card:nth-child(3n+2) {
  grid-column: 8 / span 5;
  margin-top: 15vh;
}

/* Card Type C: The "Center-Weight" (middle, wide, offset low) */
.fluid-grid .case-card:nth-child(3n+3) {
  grid-column: 3 / span 8;
  margin-top: -5vh;
  margin-bottom: 12vh;
}

/* Non-case-card items in fluid-grid (e.g. .card) – fallback to simple span */
.fluid-grid .card:nth-child(3n+1) {
  grid-column: 1 / span 8;
  margin-top: 0;
}

.fluid-grid .card:nth-child(3n+2) {
  grid-column: 8 / span 5;
  margin-top: 15vh;
}

.fluid-grid .card:nth-child(3n+3) {
  grid-column: 3 / span 8;
  margin-top: -5vh;
  margin-bottom: 12vh;
}

/* Spring reveal: preserve final transform (no extra offset on scatter cards) */
.fluid-grid .case-card.reveal-up.active,
.fluid-grid .card.reveal-up.active {
  transform: translateY(0) rotate(0deg) scale(1);
}

/* Mobile: collapse to single column, keep spacing */
@media (max-width: 768px) {
  .fluid-grid {
    display: flex;
    flex-direction: column;
    gap: 40px;
  }

  .fluid-grid .case-card:nth-child(n),
  .fluid-grid .card:nth-child(n) {
    margin: 0 !important;
    width: 100%;
    grid-column: auto;
  }
}

/* ==========================================================================
   MetaLab-style Card Expansion (work-card morph, full-width on expand)
   ========================================================================== */

.work-card {
  position: relative;
  transition: all 0.8s cubic-bezier(0.23, 1, 0.32, 1);
  transform-origin: center center;
  z-index: 1;
}

.work-card.is-expanded {
  grid-column: 1 / -1 !important;
  margin-top: 4rem !important;
  margin-bottom: 4rem !important;
  z-index: 10;
}

.work-card .details-pane {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 40px;
  max-height: 0;
  opacity: 0;
  overflow: hidden;
  transition: all 0.7s cubic-bezier(0.19, 1, 0.22, 1);
}

.work-card.is-expanded .details-pane {
  max-height: 1000px;
  opacity: 1;
  padding: 60px 0;
}

/* No shadows on cards/panels (Claude) */
body.variant-claude .panel,
body.variant-claude .card,
body.variant-claude .hero__frame,
body.variant-claude .model-card,
body.variant-claude .engagement-card,
body.variant-claude .value-card,
body.variant-claude .cost-card,
body.variant-claude .result-card,
body.variant-claude .fit-card,
body.variant-claude .tool-card,
body.variant-claude .ref-card,
body.variant-claude .cta-graphic-card,
body.variant-claude .contact-option,
body.variant-claude .testimonial,
body.variant-claude .engagement-detail,
body.variant-claude .benefit,
body.variant-claude .model-layer,
body.variant-claude .triad-node {
  box-shadow: none !important;
}

/* Structural / decorative — no border at all */
body.variant-claude .panel,
body.variant-claude .cta-graphic-card,
body.variant-claude .engagement-detail,
body.variant-claude .model-layer {
  border: none !important;
}

/* Interactive cards — transparent border, velvet highlight on hover */
body.variant-claude .card,
body.variant-claude .hero__frame,
body.variant-claude .model-card,
body.variant-claude .engagement-card,
body.variant-claude .value-card,
body.variant-claude .cost-card,
body.variant-claude .result-card,
body.variant-claude .fit-card,
body.variant-claude .tool-card,
body.variant-claude .ref-card,
body.variant-claude .contact-option,
body.variant-claude .testimonial,
body.variant-claude .benefit,
body.variant-claude .triad-node {
  border: 1px solid transparent !important;
  transition: border-color var(--sys-motion-base);
}

body.variant-claude .card:hover,
body.variant-claude .hero__frame:hover,
body.variant-claude .model-card:hover,
body.variant-claude .engagement-card:hover,
body.variant-claude .value-card:hover,
body.variant-claude .cost-card:hover,
body.variant-claude .result-card:hover,
body.variant-claude .fit-card:hover,
body.variant-claude .tool-card:hover,
body.variant-claude .ref-card:hover,
body.variant-claude .contact-option:hover,
body.variant-claude .testimonial:hover,
body.variant-claude .benefit:hover,
body.variant-claude .triad-node:hover {
  border-color: var(--sys-color-highlight) !important;
}

/* VHS card style – clean boxes with minimal technical text (MetaLab expansion cards) */
body.variant-claude .case-card {
  border: 1px solid color-mix(in srgb, var(--ref-neutral-ink), transparent 90%) !important;
  background: transparent;
  padding: var(--ref-space-lg);
  transition: border-color var(--sys-motion-base);
}

body.variant-claude .case-card:hover {
  border-color: var(--sys-color-highlight) !important;
}

body.variant-claude .case-card .card-label {
  font-size: var(--ref-text-xs);
  line-height: var(--ref-leading-normal);
  max-width: 150px;
  opacity: 0.8;
}

.divider {
  height: 1px;
  background: var(--sys-surface-border);
  border: none;
  margin: var(--ref-space-lg) 0;
}

.divider--accent {
  height: 3px;
  background: var(--stripe);
  border-radius: var(--ref-radius-full);
}

/* ==========================================================================
   Badges & Pills
   ========================================================================== */

.badge {
  display: inline-flex;
  align-items: center;
  gap: var(--ref-space-xs);
  padding: var(--ref-space-xs) var(--ref-space-sm);
  border-radius: var(--comp-badge-radius);
  background: var(--comp-badge-bg);
  border: 1px solid var(--comp-badge-border);
  font-family: var(--sys-font-mono);
  font-size: var(--comp-badge-font-size);
  text-transform: uppercase;
  letter-spacing: 0.08em;
}

.badge--accent {
  border-color: var(--sys-color-accent-subtle);
  color: var(--sys-color-accent-subtle);
}

/* ==========================================================================
   Section Headers
   ========================================================================== */

.section-header {
  display: flex;
  align-items: center;
  gap: var(--ref-space-md);
  margin-bottom: var(--ref-space-lg);
}

.section-header__label {
  font-family: var(--sys-font-family);
  font-weight: var(--ref-weight-regular);
  font-size: var(--ref-text-xs);
  color: var(--sys-color-on-surface-muted);
  white-space: nowrap;
}

.section-header__rule {
  flex: 1;
  height: 1px;
  background: var(--sys-surface-border);
}

/* ==========================================================================
   Utilities
   ========================================================================== */

.text-center {
  text-align: center;
}

.text-muted {
  color: var(--sys-color-on-surface-muted);
}

.text-accent {
  color: var(--sys-color-accent-subtle);
}

.mt-sm {
  margin-top: var(--ref-space-sm);
}

.mt-md {
  margin-top: var(--ref-space-md);
}

.mt-lg {
  margin-top: var(--ref-space-lg);
}

.mt-xl {
  margin-top: var(--ref-space-xl);
}

.mb-sm {
  margin-bottom: var(--ref-space-sm);
}

.mb-md {
  margin-bottom: var(--ref-space-md);
}

.mb-lg {
  margin-bottom: var(--ref-space-lg);
}

.mb-xl {
  margin-bottom: var(--ref-space-xl);
}

/* ==========================================================================
   Magnetic Square Cursor (Claude variant)
   ========================================================================== */

/* Hide system cursor on Claude variant */
body.variant-claude,
body.variant-claude a,
body.variant-claude button,
body.variant-claude [role="button"],
body.variant-claude .card,
body.variant-claude .hero__frame,
body.variant-claude .model-card,
body.variant-claude .engagement-card,
body.variant-claude .value-card,
body.variant-claude .cost-card,
body.variant-claude .result-card,
body.variant-claude .fit-card,
body.variant-claude .tool-card,
body.variant-claude .ref-card,
body.variant-claude .contact-option,
body.variant-claude .testimonial,
body.variant-claude .benefit,
body.variant-claude .triad-node,
body.variant-claude .case-card,
body.variant-claude .work-card {
  cursor: none !important;
}

#custom-cursor {
  position: fixed;
  top: 0;
  left: 0;
  width: var(--comp-cursor-size);
  height: var(--comp-cursor-size);
  background-color: var(--comp-cursor-color);
  pointer-events: none;
  z-index: 9999;
  transform: translate3d(0, 0, 0) translate(-50%, -50%);
  transition: background-color var(--sys-motion-slow), border-color var(--sys-motion-slow), opacity var(--sys-motion-base);
  border: 0px solid transparent;
  box-sizing: border-box;
}

/* Magnetic Lock-in Frame State – size set by script to match target element */
#custom-cursor.is-hovering {
  background-color: rgba(114, 10, 99, 0.03); /* Velvet at 3% */
  border: 1px solid var(--comp-cursor-color);
}

/* Click Feedback */
#custom-cursor.is-clicking {
  transform: translate3d(0, 0, 0) translate(-50%, -50%) scale(0.7);
  background-color: var(--sys-color-action-primary);
  border-color: var(--sys-color-action-primary);
}

/* Hide cursor when it leaves the window */
#custom-cursor.is-outside {
  opacity: 0;
}

/* ==========================================================================
   Responsive
   ========================================================================== */

@media (max-width: 768px) {
  .container {
    padding: 0 var(--ref-space-md);
  }

  h1 {
    font-size: clamp(2rem, 6vw, 2.8rem);
  }
}

@media (prefers-reduced-motion: reduce) {

  *,
  *::before,
  *::after {
    transition-duration: 0.01ms !important;
    animation-duration: 0.01ms !important;
  }
}