---
const navItems = [
  { href: "/antigravity", label: "Home" },
  { href: "/antigravity/work", label: "Work" },
];

const { pathname } = Astro.url;
---

<nav class="ag-nav">
    <div class="nav-container">
        <a href="/antigravity" class="nav-logo">WE3 <span class="variant">ANTIGRAVITY</span></a>
        <div class="nav-links">
            {navItems.map(item => (
                <a 
                    href={item.href} 
                    class:list={[
                        'nav-link', 
                        { active: pathname === item.href || (item.href !== '/antigravity' && pathname.startsWith(item.href)) }
                    ]}
                >
                    {item.label}
                </a>
            ))}
        </div>
    </div>
</nav>

<style>
    .ag-nav {
        border-bottom: 1px solid var(--ag-border);
        background: var(--ag-bg);
        position: sticky;
        top: 0;
        z-index: 100;
        padding: 1rem 0;
    }
    .nav-container {
        max-width: 1100px;
        margin: 0 auto;
        padding: 0 var(--spacing-medium);
        display: flex;
        justify-content: space-between;
        align-items: center;
    }
    .nav-logo {
        text-decoration: none;
        color: var(--ag-text);
        font-family: var(--typography-font-family-display);
        font-weight: 700;
        font-size: 1.25rem;
        letter-spacing: -0.02em;
    }
    .nav-logo .variant {
        font-family: var(--typography-font-family-mono);
        font-size: 0.65rem;
        color: var(--ag-accent);
        vertical-align: middle;
        margin-left: 0.5rem;
        letter-spacing: 0.1em;
    }
    .nav-links {
        display: flex;
        gap: 2rem;
    }
    .nav-link {
        text-decoration: none;
        color: var(--ag-text);
        font-family: var(--typography-font-family-mono);
        font-size: 0.8rem;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        opacity: 0.6;
        transition: opacity 0.2s ease, color 0.2s ease;
    }
    .nav-link:hover, .nav-link.active {
        opacity: 1;
        color: var(--ag-accent);
    }
</style>
